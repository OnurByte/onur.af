{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "types": ["bun"],
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "playwright.smoke.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
