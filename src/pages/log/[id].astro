---
import * as stylex from '@stylexjs/stylex';
import Layout from '../../layouts/Layout.astro';
import { styles } from '../../styles/pages';
import { logMetadata, getLogEntryById } from '../../portfolio/log';
import LogArticle from '../../components/LogArticle.astro';
import { logArticleSchema, siteOrigin } from '../../portfolio/seo';
const entry = getLogEntryById(Astro.params.id);
if (!entry) return Astro.rewrite('/404');
const metadata = logMetadata(entry);
---

<Layout
  title={`${metadata.title} · Onur`}
  description={metadata.summary}
  language={metadata.language}
  article={{
    publishedAt: entry.revisions[0]!.publishedAt,
    modifiedAt: entry.revisions.at(-1)!.publishedAt,
    tags: metadata.tags,
  }}
  structuredData={logArticleSchema(siteOrigin(), entry)}
>
  <main {...stylex.attrs(styles.main)}>
    <LogArticle entry={entry} />
  </main>
</Layout>
