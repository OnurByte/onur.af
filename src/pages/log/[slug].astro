---
import * as stylex from '@stylexjs/stylex';
import Layout from '../../layouts/Layout.astro';
import { styles } from '../../styles/pages';
import { logEntryForPath, logUrl } from '../../portfolio/log';
import LogArticle from '../../components/LogArticle.astro';
const entry = logEntryForPath(Astro.params.slug);
if (!entry) return Astro.rewrite('/404');
if (entry.slug !== Astro.params.slug) return Astro.redirect(logUrl(entry), 308);
---

<Layout title={`${entry.title} · Onur`} description={entry.summary}>
  <main {...stylex.attrs(styles.main)}>
    <LogArticle entry={entry} />
  </main>
</Layout>
