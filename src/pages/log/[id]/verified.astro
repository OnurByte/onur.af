---
import * as stylex from '@stylexjs/stylex';
import { verifiedStyles } from '../../../styles/verified';
import { edge } from '../../../styles/edge';
import Layout from '../../../layouts/Layout.astro';
import { styles } from '../../../styles/pages';
import { logStyles } from '../../../styles/log';
import {
  logMetadata,
  getLogEntryById,
  logProofUrl,
  logRevisionUrl,
  logUrl,
  revisionMarkdown,
} from '../../../portfolio/log';
import {
  getLogPublications,
  getLogSignatures,
} from '../../../portfolio/verified-signatures';
import {
  getLogProofs,
  getLogTimestampProofs,
} from '../../../portfolio/verified-proofs';
import { validateProofTimestamp } from '../../../portfolio/log-proof';
import WitnessStats from '../../../components/WitnessStats.astro';
import SignedMessage from '../../../components/SignedMessage.astro';
const entry = getLogEntryById(Astro.params['id']);
if (!entry) return Astro.rewrite('/404');
const version = Astro.url.searchParams.has('v')
  ? Number(Astro.url.searchParams.get('v'))
  : entry.revisions.at(-1)!.version;
const revision = entry.revisions.find(
  (revision) => revision.version === version,
);
if (!revision) return Astro.rewrite('/404');
const metadata = logMetadata(entry, version);
const key = `${entry.id}-v${version}`;
const signature = (await getLogSignatures())[key];
if (!signature) return Astro.rewrite('/404');
const portableProof = (await getLogProofs())[key];
const proofFile = `/proofs/${entry.id}-v${version}.proof.json`;
const portableTimestampStatus = portableProof?.timestamp
  ? validateProofTimestamp(portableProof.signature, portableProof.timestamp)
  : undefined;
const timestamp = (await getLogTimestampProofs())[key];
const file = logRevisionUrl(entry, version);
const markdown = revisionMarkdown(entry, version);
const publication = (await getLogPublications()).latest;
const publicationFile = publication
  ? `/proofs/log-publication-v${publication.manifest.sequence}.json`
  : undefined;
const publicationEntry = publication?.manifest.entries.find(
  (item) => item.id === entry.id && item.version === version,
);
const revisionHref = (selected: number) => {
  const url = new URL(logProofUrl(entry, selected), Astro.url);
  for (const param of ['period', 'from', 'to']) {
    const value = Astro.url.searchParams.get(param);
    if (value) url.searchParams.set(param, value);
  }
  return `${url.pathname}${url.search}#publication-evidence`;
};
---

<Layout
  title={`${metadata.title} ⁜ Verified ⁜ Onur`}
  description={`Verify revision ${String(version)} of ${metadata.title} with PGP and a fingerprint you trust.`}
  previewRevision={version}
  language={metadata.language}
>
  <main {...stylex.attrs(styles.main)}>
    <header {...stylex.attrs(verifiedStyles.header)}>
      <div {...stylex.attrs(verifiedStyles.eyebrow)}>
        <span>Verified</span>
        <a href={logUrl(entry)}>Back to Log</a>
      </div>
      <h1 {...stylex.attrs(styles.heading)}>{metadata.title}</h1>
      <p {...stylex.attrs(verifiedStyles.description)}>
        Verify this revision with a fingerprint you trust.
      </p>
      <div {...stylex.attrs(logStyles.meta, verifiedStyles.fingerprint)}>
        <time datetime={revision.publishedAt} title={revision.publishedAt}>
          {revision.publishedAt.slice(0, 10)}
        </time>
        <span>Revision {version}</span>
        <span>
          OpenPGP ⁜{' '}
          <span {...stylex.attrs(styles.mono, verifiedStyles.fingerprint)}>
            {signature.fingerprint}
          </span>
        </span>
        <a {...stylex.attrs(styles.walletLink)} href="/pgp.asc" download>
          Public key
        </a>
        <a {...stylex.attrs(styles.walletLink)} href="/pgp/identity.json">
          Machine-readable identity
        </a>
        <a {...stylex.attrs(styles.walletLink)} href={logUrl(entry)}>
          Log
        </a>
      </div>

      {entry.revisions.length > 1 && (
        <nav
          {...stylex.attrs(verifiedStyles.actions)}
          aria-label="Signed revisions"
        >
          {entry.revisions.map((item) => (
            <a
              {...stylex.attrs(
                verifiedStyles.period,
                item.version === version && verifiedStyles.selected,
              )}
              href={revisionHref(item.version)}
              aria-current={item.version === version ? 'page' : undefined}
            >
              v{item.version}
            </a>
          ))}
        </nav>
      )}
    </header>
    <div {...stylex.attrs(verifiedStyles.stack)}>
      <WitnessStats logId={entry.id} />
      <section
        id="publication-evidence"
        data-verified-card
        {...stylex.attrs(verifiedStyles.card, edge.frame)}
        aria-labelledby="signed-markdown-heading"
      >
        <h2
          id="signed-markdown-heading"
          data-scroll-section
          {...stylex.attrs(logStyles.proofTitle)}
        >
          Signed Markdown
        </h2>
        <div {...stylex.attrs(styles.keySection)}>
          <textarea
            {...stylex.attrs(styles.keyInput)}
            id="signed-markdown"
            aria-label="Signed Markdown"
            readonly
            rows={Math.min(8, markdown.split('\n').length)}
            spellcheck="false"
          >{markdown}</textarea>
          <div {...stylex.attrs(styles.keyActions)}>
            <button
              {...stylex.attrs(
                styles.button,
                styles.secondary,
                styles.compactAction,
              )}
              type="button"
              data-copy="signed-markdown"
            >
              Copy
            </button>
            <a
              {...stylex.attrs(
                styles.button,
                styles.secondary,
                styles.compactAction,
              )}
              href={file}
              download
            >
              Download
            </a>
          </div>
        </div>

        <SignedMessage
          message={signature.signature}
          download={`${file}.asc`}
          label="PGP signature"
        />
        <p {...stylex.attrs(logStyles.hash)}>SHA-256 {signature.sha256}</p>
      </section>

      <section
        data-verified-card
        {...stylex.attrs(verifiedStyles.card, edge.frame)}
        aria-labelledby="portable-proof-heading"
      >
        <h2
          id="portable-proof-heading"
          data-scroll-section
          {...stylex.attrs(logStyles.proofTitle)}
        >
          Portable proof
        </h2>
        <p {...stylex.attrs(styles.paragraph)}>
          <a
            {...stylex.attrs(styles.walletLink)}
            href="/proof-verifier.mjs"
            download
          >
            Independent verifier
          </a>
        </p>
        {portableProof ? (
          <>
            <p {...stylex.attrs(styles.paragraph)}>
              Signed revision and local media hashes.
            </p>
            <div {...stylex.attrs(logStyles.links)}>
              <a {...stylex.attrs(styles.walletLink)} href={proofFile} download>
                Proof statement
              </a>
              <a
                {...stylex.attrs(styles.walletLink)}
                href={`${proofFile}.asc`}
                download
              >
                Proof statement signature
              </a>
              {portableProof.timestamp && (
                <a
                  {...stylex.attrs(styles.walletLink)}
                  href={`${proofFile}.asc.ots`}
                  download
                >
                  Proof signature timestamp receipt
                </a>
              )}
            </div>
            <p {...stylex.attrs(styles.paragraph)}>
              {!portableProof.timestamp
                ? 'No timestamp receipt is published.'
                : portableTimestampStatus === 'pending'
                  ? 'Bitcoin confirmation pending.'
                  : 'Bitcoin proof awaiting verification.'}
            </p>
          </>
        ) : (
          <p {...stylex.attrs(styles.paragraph)}>
            This revision has no signed media manifest.
          </p>
        )}
        <div {...stylex.attrs(logStyles.links)}>
          <a
            {...stylex.attrs(styles.walletLink)}
            href={`/log/${entry.id}/archive.tar`}
            download
          >
            Download archive
          </a>
        </div>
      </section>

      <section
        id="timestamps"
        data-verified-card
        {...stylex.attrs(verifiedStyles.card, edge.frame)}
        aria-labelledby="timestamps-heading"
      >
        <h2
          id="timestamps-heading"
          data-scroll-section
          {...stylex.attrs(logStyles.proofTitle)}
        >
          Markdown timestamp
        </h2>
        {timestamp ? (
          <>
            <div {...stylex.attrs(logStyles.links)}>
              <a
                {...stylex.attrs(styles.walletLink)}
                href={`${file}.ots`}
                download
              >
                OpenTimestamps receipt
              </a>
            </div>
            <p {...stylex.attrs(styles.paragraph)}>
              {timestamp.status === 'bitcoin-verified' && timestamp.bitcoin ? (
                <>
                  <a
                    {...stylex.attrs(styles.walletLink)}
                    href={`https://blockstream.info/block-height/${timestamp.bitcoin.height}`}
                  >
                    Bitcoin ⁜ {timestamp.bitcoin.height}
                  </a>
                  <br />
                  <time
                    datetime={new Date(
                      timestamp.bitcoin.timestamp * 1000,
                    ).toISOString()}
                  >
                    {new Date(timestamp.bitcoin.timestamp * 1000)
                      .toISOString()
                      .replace('T', ' ')
                      .slice(0, 19)}{' '}
                    UTC
                  </time>
                </>
              ) : timestamp.status === 'pending' ? (
                'Bitcoin confirmation pending.'
              ) : (
                'Bitcoin proof awaiting verification.'
              )}
            </p>
          </>
        ) : (
          <p {...stylex.attrs(styles.paragraph)}>
            No OpenTimestamps receipt is published for this revision.
          </p>
        )}

        {publicationFile && (
          <div {...stylex.attrs(logStyles.links)}>
            <a
              {...stylex.attrs(styles.walletLink)}
              href="/proofs/checkpoint.json"
              download
            >
              Publication checkpoint
            </a>
            <a
              {...stylex.attrs(styles.walletLink)}
              href={`${publicationFile}.ots`}
              download
            >
              Manifest timestamp receipt
            </a>
          </div>
        )}
        {publicationFile && publicationEntry && (
          <>
            <div {...stylex.attrs(logStyles.links)}>
              <a
                {...stylex.attrs(styles.walletLink)}
                href={publicationFile}
                download
              >
                Publication edition {publication!.manifest.sequence}
              </a>
              <a
                {...stylex.attrs(styles.walletLink)}
                href={`${publicationFile}.asc`}
                download
              >
                Edition signature
              </a>
            </div>
            <p {...stylex.attrs(logStyles.hash)}>
              Publication entry {publicationEntry.id}-v
              {publicationEntry.version} ⁜ SHA-256 {publicationEntry.sha256}
            </p>
          </>
        )}
      </section>
    </div>
  </main>
</Layout>
