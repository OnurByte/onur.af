---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { publicPreview } from '../portfolio/previews';
import Layout from '../layouts/Layout.astro';
import { siteOrigin } from '../portfolio/seo';
import { rssResponse, wantsFeedHtml } from '../portfolio/feeds';
if (!wantsFeedHtml(Astro.request.headers.get('accept'))) {
  return rssResponse(siteOrigin(), Astro.url);
}
Astro.response.headers.set('Vary', 'Accept');
const feedUrl = new URL('/rss', siteOrigin() ?? Astro.url.origin).href;
const description = publicPreview('/rss')!.description;
---

<Layout title="RSS · Onur" description={description}>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>RSS</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.feedStatus)} data-page-description>
        {description}
      </p>
      <div id="feed-field" {...stylex.attrs(styles.keySection)}>
        <div {...stylex.attrs(styles.keyActions)}>
          <button
            {...stylex.attrs(
              styles.button,
              styles.secondary,
              styles.compactAction,
            )}
            id="copy-feed"
            data-copy="feed-address"
            type="button"
          >
            Copy
          </button>
          <a
            {...stylex.attrs(
              styles.button,
              styles.secondary,
              styles.compactAction,
            )}
            href={`feed:${feedUrl}`}
          >
            Subscribe
          </a>
        </div>
        <input
          {...stylex.attrs(styles.keyInput, styles.singleLineInput)}
          type="text"
          id="feed-address"
          aria-label="RSS feed URL"
          value={feedUrl}
          readonly
          spellcheck="false"
        />
      </div>
    </div>
  </main>
</Layout>
