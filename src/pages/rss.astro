---
import { publicPreview } from '../portfolio/previews';
import Layout from '../layouts/Layout.astro';
import { siteOrigin } from '../portfolio/seo';
import { rssResponse, wantsFeedHtml } from '../portfolio/feeds';
if (!wantsFeedHtml(Astro.request.headers.get('accept'))) {
  return rssResponse(siteOrigin(), Astro.url);
}
Astro.response.headers.set('Vary', 'Accept');
const feedUrl = new URL('/rss', siteOrigin() ?? Astro.url.origin).href;
const description = publicPreview('/rss')!.description;
---

<Layout title="RSS · Onur" description={description}>
  <main class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_a]:underline [&_a]:underline-offset-[0.2em] [&_p]:my-4 [&_p]:leading-[1.7]">
    <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
      RSS
    </h1>
    <div class="max-w-[65ch] leading-[1.8] [&_p]:my-6">
      <p data-page-description>{description}</p>
      <div class="my-6 flex flex-wrap items-center gap-x-5 gap-y-3 [&_span]:min-w-0 [&_button]:shrink-0">
        <span
          class="font-mono text-[0.9rem] leading-[1.7] font-normal [overflow-wrap:anywhere] select-all"
          id="feed-address"
        >
          {feedUrl}
        </span>
        <button
          class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--border)] bg-transparent px-4 py-3 text-base leading-[1.4] font-medium text-[var(--text)] hover:border-[var(--text)] hover:bg-[var(--text)] hover:text-[var(--background)]"
          id="copy-feed"
          type="button"
          aria-live="polite"
        >
          Copy address
        </button>
      </div>
      <a
        class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--text)] bg-[var(--text)] px-4 py-3 text-base leading-[1.4] font-medium text-[var(--background)] no-underline hover:border-[var(--border)] hover:bg-[var(--surface)] hover:text-[var(--text)]"
        href={`feed:${feedUrl}`}
      >
        Subscribe
      </a>
      <p id="copy-status" role="status" hidden></p>
    </div>
  </main>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-feed');
  const address = document.querySelector<HTMLElement>('#feed-address');
  const status = document.querySelector<HTMLElement>('#copy-status');
  button?.addEventListener('click', async () => {
    if (!address || !status) return;
    try {
      await navigator.clipboard.writeText(address.textContent?.trim() ?? '');
      button.textContent = 'Copied';
      status.textContent = '';
      status.hidden = true;
    } catch {
      status.textContent = 'Select the address above and copy it manually.';
      status.hidden = false;
    }
  });
</script>
