---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { edge } from '../styles/edge';
import { logStyles } from '../styles/log';
import Layout from '../layouts/Layout.astro';
import HomeEmbeds from '../components/embeds/HomeEmbeds.astro';
import Technologies from '../components/Technologies.astro';
import { homeEmbedSources } from '../content/home-embeds';
import { loadEmbeds } from '../portfolio/embed-sources';
import LogCard from '../components/LogCard.astro';
import { listedLogEntries, logProofUrl } from '../portfolio/log';
import { getLogSignatures } from '../portfolio/verified-proofs';
import ProofBadge from '../components/ProofBadge.astro';
import { introduction, introductionEntry } from '../portfolio/introduction';
import { mottos } from '../portfolio/previews';

Astro.response.headers.set('Cache-Control', 'no-store');
const homeEmbeds = await loadEmbeds(homeEmbedSources, { timeoutMs: 15_000 });
const signatures = await getLogSignatures();
const recentLogs = listedLogEntries.slice(0, 3);
const motto = mottos[Math.floor(Math.random() * mottos.length)]!;
---

<Layout title={`${motto} · Onur`} motto={motto}>
  <main {...stylex.attrs(styles.main)} aria-label="Portfolio">
    <h1 {...stylex.attrs(styles.heading)}>{motto}</h1>
    <section
      {...stylex.attrs(styles.homeIntroduction, edge.frame)}
      aria-labelledby="introduction-heading"
    >
      <div {...stylex.attrs(styles.homeIntroductionHeading)}>
        <h2 id="introduction-heading" {...stylex.attrs(styles.sectionHeading)}>
          {introduction.heading}
        </h2>
        <div {...stylex.attrs(logStyles.meta)}>
          <a
            href={`${logProofUrl(introductionEntry)}#timestamps`}
            aria-label="Introduction timestamp proof"
          >
            <time datetime={introductionEntry.revisions[0]!.publishedAt}>
              {introductionEntry.revisions[0]!.publishedAt.slice(0, 10)}
            </time>
          </a>
          <ProofBadge
            target="log"
            href={logProofUrl(introductionEntry)}
            label="Verified"
          />
        </div>
      </div>
      <div {...stylex.attrs(styles.homeIntroductionCopy)}>
        {introduction.paragraphs.map((paragraph) => (
          <p {...stylex.attrs(styles.prose, styles.homeIntroductionText)}>
            {paragraph}
          </p>
        ))}
      </div>
      <img
        {...stylex.attrs(styles.homeIntroductionPortrait)}
        src="/brand/home-identity-portrait.svg"
        width="480"
        height="480"
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    </section>
    <Technologies />
    {recentLogs.length > 0 && (
      <section
        {...stylex.attrs(logStyles.list)}
        aria-label="Recent Log entries"
        class="h-feed"
      >
        {recentLogs.map((entry) => (
          <LogCard
            entry={entry}
            verified={Boolean(
              signatures[`${entry.id}-v${entry.revisions.at(-1)!.version}`],
            )}
          />
        ))}
      </section>
    )}
    <HomeEmbeds embeds={homeEmbeds} />
  </main>
</Layout>
