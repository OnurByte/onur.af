---
import * as stylex from '@stylexjs/stylex';
import { Picture } from 'astro:assets';
import portrait from '../assets/home-identity-portrait.webp';
import { styles } from '../styles/pages';
import { edge } from '../styles/edge';
import { logStyles } from '../styles/log';
import Layout from '../layouts/Layout.astro';
import HomeActivity from '../components/embeds/HomeActivity.astro';
import Technologies from '../components/Technologies.astro';
import Connect from '../components/Connect.astro';
import LogCard from '../components/LogCard.astro';
import { listedLogEntries, logProofUrl } from '../portfolio/log';
import { getLogSignatures } from '../portfolio/verified-proofs';
import ProofBadge from '../components/ProofBadge.astro';
import { introduction, introductionEntry } from '../portfolio/introduction';
import { mottos, nextMottoIndex, publicPreview } from '../portfolio/previews';

Astro.response.headers.set('Cache-Control', 'no-store');
const signatures = await getLogSignatures();
const recentLogs = listedLogEntries.slice(0, 3);
const previousMotto = Astro.cookies.get('onur-motto')?.number();
const mottoIndex = nextMottoIndex(previousMotto);
Astro.cookies.set('onur-motto', String(mottoIndex), {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure: Astro.url.protocol === 'https:',
});
const motto = mottos[mottoIndex]!;
---

<Layout title={publicPreview('/')!.title} motto={motto}>
  <main {...stylex.attrs(styles.main)} aria-label="Portfolio">
    <h1 {...stylex.attrs(styles.heading)}>{motto}</h1>
    <section
      {...stylex.attrs(styles.homeIntroduction, edge.frame)}
      aria-labelledby="introduction-heading"
    >
      <div {...stylex.attrs(styles.homeIntroductionHeading)}>
        <h2
          id="introduction-heading"
          data-scroll-section
          {...stylex.attrs(styles.sectionHeading)}
        >
          {introduction.heading}
        </h2>
        <div {...stylex.attrs(logStyles.meta)}>
          <a
            href={`${logProofUrl(introductionEntry)}#timestamps`}
            aria-label={`Introduction timestamp proof ⁜ ${introductionEntry.revisions[0]!.publishedAt.slice(0, 10)}`}
          >
            <time datetime={introductionEntry.revisions[0]!.publishedAt}>
              {introductionEntry.revisions[0]!.publishedAt.slice(0, 10)}
            </time>
          </a>
          <ProofBadge
            target="log"
            href={logProofUrl(introductionEntry)}
            label="Verified"
          />
        </div>
      </div>
      <div {...stylex.attrs(styles.homeIntroductionCopy)}>
        {introduction.paragraphs.map((paragraph) => (
          <p {...stylex.attrs(styles.prose, styles.homeIntroductionText)}>
            {paragraph}
          </p>
        ))}
      </div>
      <Picture
        pictureAttributes={stylex.attrs(styles.homeIntroductionPortrait)}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        {...stylex.attrs(styles.homeIntroductionPortrait)}
        src={portrait}
        widths={[96, 192, 240, 480]}
        sizes="(max-width: 620px) 96px, 240px"
        data-home-portrait
        loading="eager"
        fetchpriority="low"
        width="480"
        height="480"
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    </section>
    {recentLogs.length > 0 && (
      <section
        {...stylex.attrs(logStyles.list)}
        id="recent-logs"
        data-scroll-section
        data-scroll-label="Logs"
        aria-label="Recent Log entries"
        class="h-feed"
      >
        <h2 {...stylex.attrs(styles.sectionHeading)}>
          <a href="/log">Logs</a>
        </h2>
        {recentLogs.map((entry) => (
          <LogCard
            entry={entry}
            verified={Boolean(
              signatures[`${entry.id}-v${entry.revisions.at(-1)!.version}`],
            )}
          />
        ))}
      </section>
    )}
    <div {...stylex.attrs(styles.homeContact)}>
      <Connect />
    </div>
    <Technologies />
    <HomeActivity />
  </main>
</Layout>
