---
import Layout from '../layouts/Layout.astro';

Astro.response.headers.set('Cache-Control', 'no-store');
const mottos = [
  'The creator originates.',
  'I am. I think. I will.',
  'To think is an act of choice.',
];
const motto = mottos[Math.floor(Math.random() * mottos.length)];
---

<Layout
  title="Onur · Independent software"
  description="Onur — independent software. Support my work with a private Monero donation."
>
  <main aria-label="Portfolio">
    <h1>{motto}</h1>
  </main>
</Layout>
