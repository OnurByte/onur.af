---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../portfolio/content';
export const prerender = true;
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Layout title={`${project.name} · Onur`} description={project.summary}>
  <main class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_a]:underline [&_a]:underline-offset-[0.2em] [&_h2]:mb-5 [&_h2]:text-[1.35rem] [&_h2]:font-medium [&_p]:my-4 [&_p]:leading-[1.7] leading-[1.8] [&>p]:max-w-[65ch] [&>ul]:max-w-[65ch] [&_p]:my-6 [&_ul]:my-6 [&_h2]:mt-11 [&_code]:[overflow-wrap:anywhere]">
    <a class="mb-7 inline-block" href="/projects">
      ← Projects
    </a>
    <header class="mb-10">
      <p class="text-[0.85rem] text-[var(--muted)]">{project.status}</p>
      <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
        {project.name}
      </h1>
      <p>{project.summary}</p>
    </header>
    <p>{project.description}</p>
    <h2>Approach and boundaries</h2>
    {project.details.map((detail: string) => (
      <p>{detail}</p>
    ))}
    <p>
      <a href={project.repository}>
        Read the source and project documentation ↗
      </a>
    </p>
  </main>
</Layout>
