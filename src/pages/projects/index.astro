---
import { publicPreview } from '../../portfolio/previews';
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../portfolio/content';
const description = publicPreview('/projects')!.description;
---

<Layout title="Projects · Onur" description={description}>
  <main class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_a]:underline [&_a]:underline-offset-[0.2em] [&_h2]:mb-5 [&_h2]:text-[1.35rem] [&_h2]:font-medium [&_p]:my-4 [&_p]:leading-[1.7]">
    <header class="mb-10">
      <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
        Projects
      </h1>
      <p data-page-description>{description}</p>
    </header>
    {projects.length === 0 && <p>No projects published.</p>}
    <div class="my-7 p-0">
      {projects.map((project) => (
        <article class="border-t border-[var(--border)] py-6">
          <div class="text-[0.85rem] text-[var(--muted)]">{project.status}</div>
          <h2>
            <a href={`/projects/${project.slug}`}>{project.name}</a>
          </h2>
          <p>{project.summary}</p>
          <a href={project.repository}>Source code ↗</a>
        </article>
      ))}
    </div>
  </main>
</Layout>
