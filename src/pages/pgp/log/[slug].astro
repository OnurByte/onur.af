---
import * as stylex from '@stylexjs/stylex';
import Layout from '../../../layouts/Layout.astro';
import { styles } from '../../../styles/pages';
import { logStyles } from '../../../styles/log';
import {
  logEntryForPath,
  logProofUrl,
  logRevisionUrl,
  logUrl,
} from '../../../portfolio/log';
import {
  getLogSignatures,
  getLogTimestampProofs,
} from '../../../portfolio/verified-proofs';
import SignedMessage from '../../../components/SignedMessage.astro';
const entry = logEntryForPath(Astro.params.slug);
if (!entry) return Astro.rewrite('/404');
if (entry.slug !== Astro.params.slug)
  return Astro.redirect(`${logProofUrl(entry)}${Astro.url.search}`, 308);
const version = Astro.url.searchParams.has('v')
  ? Number(Astro.url.searchParams.get('v'))
  : entry.revisions.at(-1)!.version;
const revision = entry.revisions.find(
  (revision) => revision.version === version,
);
if (!revision) return Astro.rewrite('/404');
const key = `${entry.id}-v${version}`;
const signature = (await getLogSignatures())[key];
if (!signature) return Astro.rewrite('/404');
const timestamp = (await getLogTimestampProofs())[key];
const file = logRevisionUrl(entry, version);
---

<Layout title={`${entry.title} · PGP · Onur`} description="Verified by PGP.">
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>{entry.title}</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)}>Verified by PGP.</p>
      <div {...stylex.attrs(logStyles.meta)}>
        <time datetime={revision.publishedAt} title={revision.publishedAt}>
          {revision.publishedAt.slice(0, 10)}
        </time>
        <span>v{version}</span>
        <a {...stylex.attrs(styles.walletLink)} href={logUrl(entry)}>
          Log
        </a>
      </div>
      <SignedMessage
        message={signature.signature}
        download={`${file}.asc`}
        label="PGP signature"
      />
      <div {...stylex.attrs(logStyles.links)}>
        <a {...stylex.attrs(styles.walletLink)} href={file} download>
          Markdown
        </a>
        {timestamp && (
          <a {...stylex.attrs(styles.walletLink)} href={`${file}.ots`} download>
            Timestamp
          </a>
        )}
      </div>
      {timestamp && (
        <p {...stylex.attrs(styles.paragraph)}>
          {timestamp.status === 'bitcoin-verified' && timestamp.bitcoin ? (
            <>
              <a
                {...stylex.attrs(styles.walletLink)}
                href={`https://blockstream.info/block-height/${timestamp.bitcoin.height}`}
              >
                Bitcoin · {timestamp.bitcoin.height}
              </a>
              <br />
              <time
                datetime={new Date(
                  timestamp.bitcoin.timestamp * 1000,
                ).toISOString()}
              >
                {new Date(timestamp.bitcoin.timestamp * 1000)
                  .toISOString()
                  .replace('T', ' ')
                  .slice(0, 19)}{' '}
                UTC
              </time>
            </>
          ) : timestamp.status === 'pending' ? (
            'Bitcoin confirmation pending.'
          ) : (
            'Bitcoin proof awaiting verification.'
          )}
        </p>
      )}
      <p {...stylex.attrs(logStyles.hash)}>SHA-256 {signature.sha256}</p>
      {entry.revisions.length > 1 && (
        <nav {...stylex.attrs(logStyles.links)} aria-label="Signed revisions">
          {entry.revisions.map((item) => (
            <a
              {...stylex.attrs(styles.walletLink)}
              href={logProofUrl(entry, item.version)}
              aria-current={item.version === version ? 'page' : undefined}
            >
              v{item.version}
            </a>
          ))}
        </nav>
      )}
    </div>
  </main>
</Layout>
