---
import * as stylex from '@stylexjs/stylex';
import Layout from '../../../layouts/Layout.astro';
import { styles } from '../../../styles/pages';
import { logStyles } from '../../../styles/log';
import {
  logMetadata,
  getLogEntryById,
  logProofUrl,
  logRevisionUrl,
  logUrl,
  revisionMarkdown,
} from '../../../portfolio/log';
import {
  getLogPublications,
  getLogSignatures,
  getLogTimestampProofs,
} from '../../../portfolio/verified-proofs';
import SignedMessage from '../../../components/SignedMessage.astro';
const entry = getLogEntryById(Astro.params.id);
if (!entry) return Astro.rewrite('/404');
const version = Astro.url.searchParams.has('v')
  ? Number(Astro.url.searchParams.get('v'))
  : entry.revisions.at(-1)!.version;
const revision = entry.revisions.find(
  (revision) => revision.version === version,
);
if (!revision) return Astro.rewrite('/404');
const metadata = logMetadata(entry, version);
const key = `${entry.id}-v${version}`;
const signature = (await getLogSignatures())[key];
if (!signature) return Astro.rewrite('/404');
const timestamp = (await getLogTimestampProofs())[key];
const file = logRevisionUrl(entry, version);
const markdown = revisionMarkdown(entry, version);
const publication = (await getLogPublications()).latest;
const publicationFile = publication
  ? `/proofs/log-publication-v${publication.manifest.sequence}.json`
  : undefined;
const publicationEntry = publication?.manifest.entries.find(
  (item) => item.id === entry.id && item.version === version,
);
---

<Layout
  title={`${metadata.title} · Verified · Onur`}
  description="Verified by PGP."
>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>{metadata.title}</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)}>Verified by PGP.</p>
      <div {...stylex.attrs(logStyles.meta)}>
        <time datetime={revision.publishedAt} title={revision.publishedAt}>
          {revision.publishedAt.slice(0, 10)}
        </time>
        <span>Revision {version}</span>
        <span>Ed25519 · {signature.fingerprint}</span>
        <a {...stylex.attrs(styles.walletLink)} href={logUrl(entry)}>
          Log
        </a>
      </div>

      <h2>Signed Markdown</h2>
      <div {...stylex.attrs(styles.keySection)}>
        <textarea
          {...stylex.attrs(styles.keyInput)}
          id="signed-markdown"
          aria-label="Signed Markdown"
          readonly
          rows={markdown.split('\n').length}
          spellcheck="false"
        >{markdown}</textarea>
        <div {...stylex.attrs(styles.keyActions)}>
          <button
            {...stylex.attrs(
              styles.button,
              styles.secondary,
              styles.compactAction,
            )}
            type="button"
            data-copy="signed-markdown"
          >
            Copy
          </button>
          <a
            {...stylex.attrs(
              styles.button,
              styles.secondary,
              styles.compactAction,
            )}
            href={file}
            download
          >
            Download Markdown
          </a>
        </div>
      </div>

      <SignedMessage
        message={signature.signature}
        download={`${file}.asc`}
        label="PGP signature"
      />
      <p {...stylex.attrs(logStyles.hash)}>SHA-256 {signature.sha256}</p>

      {timestamp ? (
        <>
          <div {...stylex.attrs(logStyles.links)}>
            <a
              {...stylex.attrs(styles.walletLink)}
              href={`${file}.ots`}
              download
            >
              OpenTimestamps receipt
            </a>
          </div>
          <p {...stylex.attrs(styles.paragraph)}>
            {timestamp.status === 'bitcoin-verified' && timestamp.bitcoin ? (
              <>
                <a
                  {...stylex.attrs(styles.walletLink)}
                  href={`https://blockstream.info/block-height/${timestamp.bitcoin.height}`}
                >
                  Bitcoin · {timestamp.bitcoin.height}
                </a>
                <br />
                <time
                  datetime={new Date(
                    timestamp.bitcoin.timestamp * 1000,
                  ).toISOString()}
                >
                  {new Date(timestamp.bitcoin.timestamp * 1000)
                    .toISOString()
                    .replace('T', ' ')
                    .slice(0, 19)}{' '}
                  UTC
                </time>
              </>
            ) : timestamp.status === 'pending' ? (
              'Bitcoin confirmation pending.'
            ) : (
              'Bitcoin proof awaiting verification.'
            )}
          </p>
        </>
      ) : (
        <p {...stylex.attrs(styles.paragraph)}>
          No OpenTimestamps receipt is published for this revision.
        </p>
      )}

      {publicationFile && publicationEntry && (
        <>
          <div {...stylex.attrs(logStyles.links)}>
            <a
              {...stylex.attrs(styles.walletLink)}
              href={publicationFile}
              download
            >
              Publication edition {publication!.manifest.sequence}
            </a>
            <a
              {...stylex.attrs(styles.walletLink)}
              href={`${publicationFile}.asc`}
              download
            >
              Edition signature
            </a>
          </div>
          <p {...stylex.attrs(logStyles.hash)}>
            Publication entry {publicationEntry.id}-v{publicationEntry.version}{' '}
            · SHA-256 {publicationEntry.sha256}
          </p>
        </>
      )}

      {entry.revisions.length > 1 && (
        <nav {...stylex.attrs(logStyles.links)} aria-label="Signed revisions">
          {entry.revisions.map((item) => (
            <a
              {...stylex.attrs(styles.walletLink)}
              href={logProofUrl(entry, item.version)}
              aria-current={item.version === version ? 'page' : undefined}
            >
              v{item.version}
            </a>
          ))}
        </nav>
      )}
    </div>
  </main>
</Layout>
