---
import { moneroConfiguration } from '../../donations/config';
import * as stylex from '@stylexjs/stylex';
import { styles } from '../../styles/pages';
import Layout from '../../layouts/Layout.astro';
import { makePaymentURI, qrSvg } from 'xmr-pay/core';
import { parseCheckoutDonation } from '../../donations/checkout';
import { donationGateway } from '../../client/gateway';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const id = (Astro.params['id'] ?? '').toLowerCase();
const UUID =
  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
let donation: ReturnType<typeof parseCheckoutDonation> | undefined;
let unavailable = false;
const network = moneroConfiguration().network;
const networkValid = ['mainnet', 'stagenet', 'testnet'].includes(network);
if (!networkValid) unavailable = true;
if (UUID.test(id)) {
  try {
    const { url: base, token } = donationGateway();
    const endpoint = new URL(`/donations/${id}`, base);
    const response = await fetch(endpoint, {
      headers: { authorization: `Bearer ${token}` },
      signal: AbortSignal.timeout(3000),
      redirect: 'error',
    });
    if (!response.ok) {
      if (response.status === 404) Astro.response.status = 404;
      throw new Error('unavailable');
    }
    donation = parseCheckoutDonation(await response.json(), id, network);
    unavailable ||= donation.unavailable;
  } catch {
    unavailable = true;
  }
} else {
  unavailable = true;
  Astro.response.status = 404;
}
if (unavailable && Astro.response.status !== 404) Astro.response.status = 503;
const state =
  unavailable || donation?.unavailable
    ? 'unavailable'
    : donation?.syncing
      ? 'syncing'
      : donation?.status === 'paid'
        ? 'paid'
        : ['partial', 'underpaid'].includes(donation?.status ?? '')
          ? 'partial'
          : ['unconfirmed', 'locked', 'mempool'].includes(
                donation?.status ?? '',
              )
            ? 'confirming'
            : donation?.status === 'pending'
              ? 'waiting'
              : 'syncing';
const paymentAmount =
  state === 'partial'
    ? donation?.shortfall && donation.shortfall !== '0'
      ? donation.shortfall
      : undefined
    : state === 'waiting'
      ? donation?.amount
      : undefined;
const shownAmount = state === 'partial' ? paymentAmount : donation?.amount;
const uri =
  donation && networkValid && paymentAmount
    ? makePaymentURI({
        address: donation.address,
        amount: paymentAmount,
        recipientName: 'Onur',
        description: 'Contribution',
        networkType: network as 'mainnet' | 'stagenet' | 'testnet',
      })
    : '';
const qr = uri
  ? qrSvg(uri, {
      ec: 'H',
      moduleColor: '#000000',
      finderColor: '#000000',
      scale: 5,
      quietZone: 4,
    })
  : '';
const statusText = (
  {
    unavailable: 'Payment status unavailable',
    paid: 'Contribution received',
    partial: 'Partial payment received',
    confirming: 'Payment detected ⁜ confirming',
    waiting: 'Waiting for payment',
    syncing: 'Payment network syncing',
  } as const
)[state];
const shownStatus =
  state === 'confirming' &&
  donation?.confirmations !== undefined &&
  donation.minConfirmations !== undefined
    ? `Payment detected ⁜ confirming ${donation.confirmations}/${donation.minConfirmations}`
    : statusText;
const partialDetails =
  state === 'partial' &&
  donation?.received !== undefined &&
  donation.shortfall !== undefined
    ? `Received ${donation.received} XMR ⁜ Remaining ${donation.shortfall} XMR`
    : undefined;
---

<Layout
  title="XMR contribution ⁜ Onur"
  description="View the status of your private Monero contribution."
  noindex
>
  <main {...stylex.attrs(styles.main)}>
    <p {...stylex.attrs(styles.kicker)}>MONERO ⁜ {network.toUpperCase()}</p>
    <h1 {...stylex.attrs(styles.heading)}>Your contribution</h1>
    <p
      {...stylex.attrs(styles.status, state === 'paid' && styles.paid)}
      data-state={state}
      role="status"
    >
      {shownStatus}
    </p>
    {donation && (
      <>
        <div {...stylex.attrs(styles.paymentGrid)}>
          {qr && (
            <div
              {...stylex.attrs(styles.qr)}
              data-payment-qr
              role="img"
              set:html={qr}
              aria-label="Monero payment QR code"
            />
          )}
          <div {...stylex.attrs(styles.paymentDetails)}>
            <p {...stylex.attrs(styles.kicker, styles.paymentParagraph)}>
              {state === 'partial' ? 'REMAINING AMOUNT' : 'AMOUNT'}
            </p>
            <p {...stylex.attrs(styles.amount, styles.paymentParagraph)}>
              <span id="amount">{shownAmount ?? 'Unavailable'}</span>
              {shownAmount && ' XMR'}{' '}
              {paymentAmount && (
                <button
                  {...stylex.attrs(styles.button, styles.secondary)}
                  type="button"
                  data-copy="amount"
                >
                  Copy amount
                </button>
              )}
            </p>
            {state === 'partial' && (
              <p {...stylex.attrs(styles.note, styles.paymentParagraph)}>
                Requested contribution: {donation.amount} XMR
              </p>
            )}
            <p
              {...stylex.attrs(
                styles.kicker,
                styles.paymentParagraph,
                styles.addressKicker,
              )}
            >
              PAYMENT ADDRESS
            </p>
            <p
              {...stylex.attrs(styles.mono, styles.paymentParagraph)}
              id="address"
            >
              {donation.address}
            </p>
            <div {...stylex.attrs(styles.paymentActions)}>
              <button
                {...stylex.attrs(styles.button, styles.secondary)}
                type="button"
                data-copy="address"
              >
                Copy address
              </button>
              {uri && (
                <a {...stylex.attrs(styles.walletLink)} href={uri}>
                  Open in wallet ↗
                </a>
              )}
            </div>
            <p {...stylex.attrs(styles.note, styles.paymentParagraph)}>
              {state === 'paid'
                ? 'Thank you for your support. No further payment is needed.'
                : paymentAmount
                  ? 'Send the exact amount to this address. This address belongs to this contribution.'
                  : 'Refresh the payment status before sending any further payment.'}
            </p>
          </div>
        </div>
        {partialDetails && (
          <p {...stylex.attrs(styles.callout, styles.partialDetails)}>
            {partialDetails}
            <br />
            Send the remaining amount to this same address.
          </p>
        )}
        <form
          method="get"
          action={`/contribute/${id}`}
          {...stylex.attrs(styles.form)}
        >
          <button
            {...stylex.attrs(styles.button, styles.secondary)}
            type="submit"
          >
            Refresh payment status
          </button>
        </form>
      </>
    )}
    {!donation && (
      <p {...stylex.attrs(styles.unavailable)}>
        We couldn’t load this payment. Try refreshing the page in a moment.
      </p>
    )}
    <noscript>
      <p {...stylex.attrs(styles.note)}>
        Copy manually by selecting the amount or address.
      </p>
    </noscript>
  </main>
</Layout>
