---
import * as stylex from '@stylexjs/stylex';
import { amountMarker, styles } from '../../styles/pages';
import { publicPreview } from '../../portfolio/previews';
import { moneroConfiguration } from '../../donations/config';
import Layout from '../../layouts/Layout.astro';
import { formatXmrAmount, parseXmrAmount } from '../../donations/money';
const { openAlias } = moneroConfiguration();
const amounts = ['0.01', '0.05', '0.1', '0.25'];
Astro.response.headers.set('Cache-Control', 'private, no-store');
// Same-origin keeps the form Origin header; no-referrer makes browsers send
// `Origin: null`, which the POST handler must reject.
Astro.response.headers.set('Referrer-Policy', 'same-origin');
const query = Astro.url.searchParams;
const retryId = query.get('retry') ?? '';
const id =
  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    retryId,
  )
    ? retryId
    : crypto.randomUUID();
const requestedAmount = query.get('choice') ?? '';
const selectedAmount = amounts.includes(requestedAmount)
  ? requestedAmount
  : '0.05';
const customSelected = requestedAmount === 'custom';
let customAmount = query.get('custom') ?? '';
try {
  if (customAmount)
    customAmount = formatXmrAmount(parseXmrAmount(customAmount));
} catch {
  customAmount = '';
}
const description = publicPreview('/contribute')!.description;
---

<Layout title="Contribute ⁜ Onur" description={description}>
  <main {...stylex.attrs(styles.main)} aria-label="Monero contribution">
    <h1 {...stylex.attrs(styles.heading)}>Contribute</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)} data-page-description>
        {description}
      </p>
    </div>
    {query.has('error') && (
      <p {...stylex.attrs(styles.callout, styles.error)} role="alert">
        {query.get('error') === 'amount'
          ? 'Enter an amount greater than 0 and no more than 100 XMR, with up to 12 decimal places.'
          : 'The contribution service is temporarily unavailable. Retry this contribution or try again shortly.'}
      </p>
    )}
    <section {...stylex.attrs(styles.prose)} aria-labelledby="openalias-title">
      <h2
        id="openalias-title"
        data-scroll-section
        {...stylex.attrs(styles.sectionHeading)}
      >
        OpenAlias
      </h2>
      {openAlias ? (
        <>
          <p {...stylex.attrs(styles.note)}>
            Use this alias in a compatible Monero wallet. Direct contributions
            do not appear in the payment tracker below.
          </p>
          <div {...stylex.attrs(styles.paymentActions)}>
            <code id="openalias" {...stylex.attrs(styles.mono)}>
              {openAlias}
            </code>
            <button
              type="button"
              data-copy="openalias"
              {...stylex.attrs(styles.button, styles.secondary)}
            >
              Copy
            </button>
          </div>
        </>
      ) : (
        <p {...stylex.attrs(styles.note)}>Not configured</p>
      )}
    </section>
    <form
      {...stylex.attrs(styles.form)}
      method="post"
      action="/contribute/create"
    >
      <fieldset {...stylex.attrs(styles.fieldset)}>
        <legend {...stylex.attrs(styles.legend)}>Amount</legend>
        {amounts.map((amount) => (
          <label {...stylex.attrs(styles.choice, amountMarker)}>
            <input
              {...stylex.attrs(styles.radio, amountMarker)}
              type="radio"
              name="amount"
              value={amount}
              checked={!customSelected && selectedAmount === amount}
            />
            <span {...stylex.attrs(styles.choiceText)}>{amount} XMR</span>
          </label>
        ))}
        <label {...stylex.attrs(styles.choice, amountMarker)}>
          <input
            {...stylex.attrs(styles.radio, amountMarker)}
            type="radio"
            name="amount"
            value="custom"
            checked={customSelected}
          />
          <span {...stylex.attrs(styles.choiceText)}>Custom</span>
        </label>
      </fieldset>
      <label {...stylex.attrs(styles.customLabel)}>
        Custom amount in XMR
        <input
          {...stylex.attrs(styles.customInput)}
          name="customAmount"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          maxlength="16"
          placeholder="e.g. 0.075"
          value={customAmount}
        />
        <span {...stylex.attrs(styles.muted)}>
          More than 0, up to 100 XMR; 12 decimal places maximum.
        </span>
      </label>
      <input type="hidden" name="id" value={id} />
      <button {...stylex.attrs(styles.button, styles.primary)} type="submit">
        Continue to payment <span aria-hidden="true">↗</span>
      </button>
    </form>
  </main>
</Layout>
