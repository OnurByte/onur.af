---
import * as stylex from '@stylexjs/stylex';
import Layout from '../layouts/Layout.astro';
import { styles } from '../styles/pages';
import { logStyles } from '../styles/log';
import { logEntries, logProofUrl, logUrl, readingTime } from '../portfolio/log';
import { publicPreview } from '../portfolio/previews';
import ProofBadge from '../components/ProofBadge.astro';
import { getLogSignatures } from '../portfolio/verified-proofs';
const signatures = await getLogSignatures();
---

<Layout title="Log · Onur" description={publicPreview('/log')!.description}>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>Log</h1>
    <div {...stylex.attrs(logStyles.list)} class="h-feed">
      {logEntries.map((entry) => (
        <article
          {...stylex.attrs(logStyles.entryCard)}
          class="h-entry"
          id={entry.id}
        >
          <h2 {...stylex.attrs(logStyles.title)}>
            <a class="u-url p-name" href={logUrl(entry)}>
              {entry.title}
            </a>
          </h2>
          <div {...stylex.attrs(logStyles.meta)}>
            <time
              class="dt-published"
              datetime={entry.revisions[0]!.publishedAt}
            >
              {entry.revisions[0]!.publishedAt.slice(0, 10)}
            </time>
            {signatures[`${entry.id}-v${entry.revisions.at(-1)!.version}`] && (
              <ProofBadge
                target="log"
                href={logProofUrl(entry)}
                label="Verified"
              />
            )}
            <span>{readingTime(entry.revisions.at(-1)!.body)}</span>
          </div>
          <p {...stylex.attrs(logStyles.excerpt)} class="p-summary">
            {entry.summary}
          </p>
        </article>
      ))}
    </div>
  </main>
</Layout>
