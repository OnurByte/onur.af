---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { publicPreview } from '../portfolio/previews';
import Layout from '../layouts/Layout.astro';
import ProofRegistry from '../components/ProofRegistry.astro';
import publicKey from '../../public/pgp.asc?raw';
import { readKey } from 'openpgp';
import { getSignedIdentityStatement } from '../portfolio/verified-proofs';
const description = publicPreview('/pgp')!.description;
await getSignedIdentityStatement();
const keyText = publicKey.trim();
const fingerprint =
  (await readKey({ armoredKey: publicKey }))
    .getFingerprint()
    .toUpperCase()
    .match(/.{1,4}/g)
    ?.join(' ') ?? '';
---

<Layout title="PGP ⁜ Onur" description={description}>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>PGP</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)} data-page-description>
        {description}
      </p>
      <h2
        id="account-ownership"
        data-scroll-section
        {...stylex.attrs(styles.sectionHeading)}
      >
        Account ownership
      </h2>
      <p {...stylex.attrs(styles.paragraph)}>
        <a
          {...stylex.attrs(styles.walletLink)}
          href="/pgp/identity.asc"
          download
        >
          Signed ownership statement
        </a>
      </p>
      <div id="fingerprint-field" {...stylex.attrs(styles.keySection)}>
        <div id="fingerprint-actions" {...stylex.attrs(styles.keyActions)}>
          <button
            {...stylex.attrs(
              styles.button,
              styles.secondary,
              styles.compactAction,
            )}
            id="copy-fingerprint"
            data-copy="fingerprint-value"
            type="button"
          >
            Copy
          </button>
        </div>
        <input
          {...stylex.attrs(styles.keyInput, styles.singleLineInput)}
          type="text"
          id="fingerprint-value"
          aria-label="PGP fingerprint"
          value={fingerprint}
          readonly
          spellcheck="false"
        />
      </div>
    </div>
    <div {...stylex.attrs(styles.keySection)}>
      <textarea
        {...stylex.attrs(styles.keyInput)}
        id="public-key"
        aria-label="Public key"
        readonly
        rows={keyText.split(/\r?\n/).length}
        spellcheck="false"
      >{keyText}</textarea>
      <div id="key-actions" {...stylex.attrs(styles.keyActions)}>
        <button
          {...stylex.attrs(
            styles.button,
            styles.secondary,
            styles.compactAction,
          )}
          type="button"
          id="copy-key"
          data-copy="public-key"
          data-copy-status="key-copy-status"
        >
          Copy
        </button>
        <a
          {...stylex.attrs(
            styles.button,
            styles.secondary,
            styles.compactAction,
          )}
          href="/pgp.asc"
          download
        >
          Download
        </a>
      </div>
      <p id="key-copy-status" role="status"></p>
    </div>
    <ProofRegistry />
  </main>
</Layout>

<script>
  const key = document.querySelector<HTMLTextAreaElement>('#public-key');
  const fitKey = () => {
    if (!key) return;
    key.style.height = 'auto';
    key.style.height = `${key.scrollHeight + key.offsetHeight - key.clientHeight}px`;
    key.style.overflow = 'hidden';
  };
  fitKey();
  window.addEventListener('resize', fitKey);
  void document.fonts.ready.then(fitKey);
  if (key) {
    let width = key.getBoundingClientRect().width;
    new ResizeObserver(() => {
      const nextWidth = key.getBoundingClientRect().width;
      if (nextWidth === width) return;
      width = nextWidth;
      fitKey();
    }).observe(key);
  }
</script>
