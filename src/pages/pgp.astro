---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { publicPreview } from '../portfolio/previews';
import Layout from '../layouts/Layout.astro';
import publicKey from '../../public/pgp.asc?raw';
const description = publicPreview('/pgp')!.description;
---

<Layout title="PGP · Onur" description={description}>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>PGP</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)} data-page-description>
        {description}
      </p>
      <p {...stylex.attrs(styles.mono, styles.paragraph)}>
        3356 36C1 5D02 326F 9A43 1C98 4103 A3DD C441 9B61
      </p>
      <a
        {...stylex.attrs(styles.button, styles.primary)}
        href="/pgp.asc"
        download
      >
        Download public key
      </a>
    </div>
    <pre {...stylex.attrs(styles.key)}><code>{publicKey.trim()}</code></pre>
  </main>
</Layout>
