---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { publicPreview } from '../portfolio/previews';
import Layout from '../layouts/Layout.astro';
import publicKey from '../../public/pgp.asc?raw';
const description = publicPreview('/pgp')!.description;
const keyText = publicKey.trim();
---

<Layout title="PGP · Onur" description={description}>
  <main {...stylex.attrs(styles.main)} data-copy-allowed>
    <h1 {...stylex.attrs(styles.heading)}>PGP</h1>
    <div {...stylex.attrs(styles.prose)}>
      <p {...stylex.attrs(styles.paragraph)} data-page-description>
        {description}
      </p>
      <p {...stylex.attrs(styles.mono, styles.paragraph)}>
        3356 36C1 5D02 326F 9A43 1C98 4103 A3DD C441 9B61
      </p>
      <a
        {...stylex.attrs(styles.button, styles.primary)}
        href="/pgp.asc"
        download
      >
        Download public key
      </a>
    </div>
    <div {...stylex.attrs(styles.keySection)}>
      <label for="public-key">Public key</label>
      <textarea
        {...stylex.attrs(styles.keyInput)}
        id="public-key"
        readonly
        rows={keyText.split(/\r?\n/).length}
        spellcheck="false"
      >{keyText}</textarea>
      <button
        {...stylex.attrs(styles.button, styles.secondary)}
        type="button"
        id="copy-key"
      >
        Copy public key
      </button>
      <p id="key-copy-status" role="status"></p>
    </div>
  </main>
</Layout>

<script>
  const key = document.querySelector<HTMLTextAreaElement>('#public-key');
  const button = document.querySelector<HTMLButtonElement>('#copy-key');
  const status = document.querySelector<HTMLElement>('#key-copy-status');
  const fitKey = () => {
    if (!key) return;
    key.style.height = 'auto';
    key.style.height = `${key.scrollHeight + key.offsetHeight - key.clientHeight}px`;
    key.style.overflow = 'hidden';
  };
  fitKey();
  window.addEventListener('resize', fitKey);
  void document.fonts.ready.then(fitKey);
  key?.addEventListener('focus', () => key.select());
  button?.addEventListener('click', async () => {
    if (!key || !status) return;
    try {
      await navigator.clipboard.writeText(key.value);
      status.textContent = 'Public key copied.';
    } catch {
      key.focus();
      key.select();
      status.textContent =
        'Press Ctrl+C or Command+C to copy the selected key.';
    }
  });
</script>
