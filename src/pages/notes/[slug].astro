---
import Layout from '../../layouts/Layout.astro';
import { notes } from '../../portfolio/content';
export const prerender = true;
export function getStaticPaths() {
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}
const { note } = Astro.props;
---

<Layout title={`${note.title} · Onur`} description={note.summary}>
  <main class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_a]:underline [&_a]:underline-offset-[0.2em] [&_h2]:mb-5 [&_h2]:text-[1.35rem] [&_h2]:font-medium [&_p]:my-4 [&_p]:leading-[1.7] leading-[1.8] [&>p]:max-w-[65ch] [&>ul]:max-w-[65ch] [&_p]:my-6 [&_ul]:my-6 [&_h2]:mt-11 [&_code]:[overflow-wrap:anywhere]">
    <a class="mb-7 inline-block" href="/notes">
      ← Notes
    </a>
    <header class="mb-10">
      <time class="text-[0.85rem] text-[var(--muted)]" datetime={note.date}>
        {note.date}
      </time>
      <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
        {note.title}
      </h1>
      <p>{note.summary}</p>
    </header>
    {note.paragraphs.map((paragraph: string) => (
      <p>{paragraph}</p>
    ))}
    <p>
      <a href="/rss">Follow new notes through RSS</a>
    </p>
  </main>
</Layout>
