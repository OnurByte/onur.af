---
import { publicPreview } from '../../portfolio/previews';
import Layout from '../../layouts/Layout.astro';
import { formatXmrAmount, parseXmrAmount } from '../../donations/money';
const amounts = ['0.01', '0.05', '0.1', '0.25'];
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const query = Astro.url.searchParams;
const retryId = query.get('retry') ?? '';
const id =
  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    retryId,
  )
    ? retryId
    : crypto.randomUUID();
const requestedAmount = query.get('choice') ?? '';
const selectedAmount = amounts.includes(requestedAmount)
  ? requestedAmount
  : '0.05';
const customSelected = requestedAmount === 'custom';
let customAmount = query.get('custom') ?? '';
try {
  if (customAmount)
    customAmount = formatXmrAmount(parseXmrAmount(customAmount));
} catch {
  customAmount = '';
}
const description = publicPreview('/donate')!.description;
---

<Layout title="Donate · Onur" description={description}>
  <main
    class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_form]:max-w-[740px]"
    aria-label="Monero donation"
  >
    <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
      Donate
    </h1>
    <div class="max-w-[65ch] leading-[1.8] [&_p]:my-6 [&_ul]:my-6 [&_h2]:mt-11 [&_code]:[overflow-wrap:anywhere]">
      <p data-page-description>{description}</p>
    </div>
    {query.has('error') && (
      <p
        class="border-l-2 border-[var(--text)] pl-3 text-[var(--text)]"
        role="alert"
      >
        {query.get('error') === 'amount'
          ? 'Enter an amount greater than 0 and no more than 100 XMR, with up to 12 decimal places.'
          : 'The donation service is temporarily unavailable. Retry this same donation or try again shortly.'}
      </p>
    )}
    <form class="mt-9" method="post" action="/donate/create">
      <fieldset class="m-0 flex flex-wrap gap-3 border-0 p-0">
        <legend class="mb-4 w-full text-[0.9rem] text-[var(--muted)]">
          Amount
        </legend>
        {amounts.map((amount) => (
          <label class="relative cursor-pointer text-base leading-[1.4] font-medium [&_span]:block [&_span]:min-h-11 [&_span]:rounded [&_span]:border [&_span]:border-[var(--border)] [&_span]:bg-[var(--background)] [&_span]:px-4 [&_span]:py-3 hover:[&_span]:border-[var(--muted)]">
            <input
              class="peer absolute inset-0 opacity-0"
              type="radio"
              name="amount"
              value={amount}
              checked={!customSelected && selectedAmount === amount}
            />
            <span class="peer-checked:border-[var(--text)]! peer-checked:bg-[var(--text)]! peer-checked:text-[var(--background)] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-[var(--text)]">
              {amount} XMR
            </span>
          </label>
        ))}
        <label class="relative cursor-pointer text-base leading-[1.4] font-medium [&_span]:block [&_span]:min-h-11 [&_span]:rounded [&_span]:border [&_span]:border-[var(--border)] [&_span]:bg-[var(--background)] [&_span]:px-4 [&_span]:py-3 hover:[&_span]:border-[var(--muted)]">
          <input
            class="peer absolute inset-0 opacity-0"
            type="radio"
            name="amount"
            value="custom"
            checked={customSelected}
          />
          <span class="peer-checked:border-[var(--text)]! peer-checked:bg-[var(--text)]! peer-checked:text-[var(--background)] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-[var(--text)]">
            Custom
          </span>
        </label>
      </fieldset>
      <label class="mt-6 grid max-w-80 gap-2 text-[0.95rem] [&_span]:text-[var(--muted)]">
        Custom amount in XMR
        <input
          class="min-h-11 rounded border border-[var(--border)] bg-[var(--surface)] p-3 text-base leading-[1.4] font-medium text-[var(--text)] focus:border-[var(--muted)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--text)]"
          name="customAmount"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          maxlength="16"
          placeholder="e.g. 0.075"
          value={customAmount}
        />
        <span>More than 0, up to 100 XMR; 12 decimal places maximum.</span>
      </label>
      <input type="hidden" name="id" value={id} />
      <button
        class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--text)] bg-[var(--text)] px-4 py-3 text-base leading-[1.4] font-medium text-[var(--background)] no-underline hover:border-[var(--border)] hover:bg-[var(--surface)] hover:text-[var(--text)]"
        type="submit"
      >
        Continue to payment <span aria-hidden="true">↗</span>
      </button>
    </form>
  </main>
</Layout>
