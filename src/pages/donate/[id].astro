---
import Layout from '../../layouts/Layout.astro';
import { makePaymentURI, qrSvg } from 'xmr-pay/core';
import {
  formatXmrAmount,
  parseXmrAmount,
  parseXmrAmountOrZero,
} from '../../donations/money';
import { donationGateway } from '../../client/gateway';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const id = (Astro.params.id ?? '').toLowerCase();
const UUID =
  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
let donation:
  | {
      id: string;
      amount: string;
      address: string;
      status?: string;
      unavailable?: boolean;
      syncing?: boolean;
      confirmations?: number;
      minConfirmations?: number;
      received?: string;
      shortfall?: string;
    }
  | undefined;
let unavailable = false;
const network =
  import.meta.env.XMR_NETWORK ?? process.env.XMR_NETWORK ?? 'stagenet';
const networkValid = ['mainnet', 'stagenet', 'testnet'].includes(network);
if (!networkValid) unavailable = true;
const subaddressPrefix =
  network === 'mainnet' ? '8' : network === 'stagenet' ? '7' : 'B';
if (UUID.test(id)) {
  try {
    const { url: base, token } = donationGateway();
    const endpoint = new URL(`/donations/${id}`, base);
    const response = await fetch(endpoint, {
      headers: { authorization: `Bearer ${token}` },
      signal: AbortSignal.timeout(3000),
      redirect: 'error',
    });
    if (!response.ok) {
      if (response.status === 404) Astro.response.status = 404;
      throw new Error('unavailable');
    }
    const value: unknown = await response.json();
    if (!value || typeof value !== 'object') throw new Error('unavailable');
    const row = value as Record<string, unknown>;
    const address = row.address;
    const amount = row.amount;
    if (
      row.id !== id ||
      typeof amount !== 'string' ||
      typeof address !== 'string' ||
      !new RegExp(`^${subaddressPrefix}[1-9A-HJ-NP-Za-km-z]{94}$`).test(address)
    )
      throw new Error('unavailable');
    parseXmrAmount(amount);
    const status =
      row.status && typeof row.status === 'object'
        ? (row.status as Record<string, unknown>)
        : undefined;
    const paymentStatus =
      typeof status?.status === 'string'
        ? status.status
        : typeof row.status === 'string'
          ? row.status
          : undefined;
    const confirmations =
      typeof status?.confirmations === 'number' &&
      Number.isSafeInteger(status.confirmations)
        ? status.confirmations
        : undefined;
    const minConfirmations =
      typeof status?.minConfirmations === 'number' &&
      Number.isSafeInteger(status.minConfirmations)
        ? status.minConfirmations
        : undefined;
    let received: string | undefined;
    if (
      typeof status?.receivedXmr === 'number' &&
      Number.isFinite(status.receivedXmr) &&
      status.receivedXmr >= 0 &&
      status.receivedXmr <= 100
    ) {
      try {
        received = formatXmrAmount(
          parseXmrAmountOrZero(status.receivedXmr.toFixed(12)),
        );
      } catch {}
    }
    let shortfall: string | undefined;
    if (typeof status?.shortfallXmr === 'string') {
      try {
        shortfall = formatXmrAmount(parseXmrAmountOrZero(status.shortfallXmr));
      } catch {}
    }
    unavailable = unavailable || row.unavailable === true || !paymentStatus;
    donation = {
      id,
      amount,
      address,
      status: paymentStatus,
      syncing: status?.syncing === true,
      confirmations,
      minConfirmations,
      received,
      shortfall,
      unavailable,
    };
  } catch {
    unavailable = true;
  }
} else {
  unavailable = true;
  Astro.response.status = 404;
}
if (unavailable && Astro.response.status !== 404) Astro.response.status = 503;
const state =
  unavailable || donation?.unavailable
    ? 'unavailable'
    : donation?.syncing
      ? 'syncing'
      : donation?.status === 'paid'
        ? 'paid'
        : ['partial', 'underpaid'].includes(donation?.status ?? '')
          ? 'partial'
          : ['unconfirmed', 'locked', 'mempool'].includes(
                donation?.status ?? '',
              )
            ? 'confirming'
            : donation?.status === 'pending'
              ? 'waiting'
              : 'syncing';
const paymentAmount =
  state === 'partial'
    ? donation?.shortfall && donation.shortfall !== '0'
      ? donation.shortfall
      : undefined
    : state === 'waiting'
      ? donation?.amount
      : undefined;
const shownAmount = state === 'partial' ? paymentAmount : donation?.amount;
const uri =
  donation && networkValid && paymentAmount
    ? makePaymentURI({
        address: donation.address,
        amount: paymentAmount,
        recipientName: 'Onur',
        description: 'Donation',
        networkType: network as 'mainnet' | 'stagenet' | 'testnet',
      })
    : '';
const qr = uri
  ? qrSvg(uri, {
      ec: 'H',
      moduleColor: '#000000',
      finderColor: '#000000',
      scale: 5,
      quietZone: 4,
    })
  : '';
const statusText = (
  {
    unavailable: 'Payment status unavailable',
    paid: 'Donation received',
    partial: 'Partial payment received',
    confirming: 'Payment detected · confirming',
    waiting: 'Waiting for payment',
    syncing: 'Payment network syncing',
  } as const
)[state];
const shownStatus =
  state === 'confirming' &&
  donation?.confirmations !== undefined &&
  donation.minConfirmations !== undefined
    ? `Payment detected · confirming ${donation.confirmations}/${donation.minConfirmations}`
    : statusText;
const partialDetails =
  state === 'partial' &&
  donation?.received !== undefined &&
  donation.shortfall !== undefined
    ? `Received ${donation.received} XMR · Remaining ${donation.shortfall} XMR`
    : undefined;
---

<Layout
  title="XMR donation · Onur"
  description="View the status of your private Monero donation."
  noindex
>
  <main class="mx-auto w-[calc(100%_-_40px)] max-w-[960px] flex-1 pt-10 pb-[104px] min-[621px]:w-[calc(100%_-_48px)] min-[621px]:pt-[72px] [&_form]:max-w-[740px]">
    <p class="mb-3 text-[0.8rem] tracking-[0.02em] text-[var(--muted)] uppercase">
      MONERO · {network.toUpperCase()}
    </p>
    <h1 class="max-w-full text-[clamp(2.25rem,9vw,3rem)] leading-[1.1] font-normal tracking-[-0.03em] [overflow-wrap:anywhere]">
      Your donation
    </h1>
    <p
      class="my-4 inline-flex items-center rounded border border-[var(--border)] px-3 py-2 text-base leading-[1.3] font-normal data-[state=paid]:border-[var(--text)] data-[state=paid]:text-[var(--text)]"
      data-state={state}
      role="status"
    >
      {shownStatus}
    </p>
    {donation && (
      <>
        <div class="mt-10 grid max-w-[740px] grid-cols-1 items-start gap-7 min-[621px]:grid-cols-[minmax(180px,260px)_minmax(0,1fr)] min-[621px]:gap-9">
          {qr && (
            <div
              class="w-full max-w-[300px] bg-white p-2 text-black min-[621px]:max-w-[260px] [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
              role="img"
              set:html={qr}
              aria-label="Monero payment QR code"
            />
          )}
          <div class="[&_p]:mt-0 [&_p]:mb-4">
            <p class="mb-3 text-[0.8rem] tracking-[0.02em] text-[var(--muted)] uppercase">
              {state === 'partial' ? 'REMAINING AMOUNT' : 'AMOUNT'}
            </p>
            <p class="text-2xl font-normal">
              <span id="amount">{shownAmount ?? 'Unavailable'}</span>
              {shownAmount && ' XMR'}{' '}
              {paymentAmount && (
                <button
                  class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--border)] bg-transparent px-4 py-3 text-base leading-[1.4] font-medium text-[var(--text)] hover:border-[var(--text)] hover:bg-[var(--text)] hover:text-[var(--background)]"
                  type="button"
                  data-copy="amount"
                >
                  Copy amount
                </button>
              )}
            </p>
            {state === 'partial' && (
              <p class="mt-6 text-[0.9rem] leading-[1.7] text-[var(--muted)]">
                Requested donation: {donation.amount} XMR
              </p>
            )}
            <p class="mb-3 text-[0.8rem] tracking-[0.02em] text-[var(--muted)] uppercase mt-8!">
              PAYMENT ADDRESS
            </p>
            <p
              class="font-mono text-[0.9rem] leading-[1.7] font-normal [overflow-wrap:anywhere] select-all"
              id="address"
            >
              {donation.address}
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <button
                class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--border)] bg-transparent px-4 py-3 text-base leading-[1.4] font-medium text-[var(--text)] hover:border-[var(--text)] hover:bg-[var(--text)] hover:text-[var(--background)]"
                type="button"
                data-copy="address"
              >
                Copy address
              </button>
              {uri && (
                <a
                  class="text-[0.9rem] underline underline-offset-[0.3em]"
                  href={uri}
                >
                  Open in wallet ↗
                </a>
              )}
            </div>
            <p class="mt-6 text-[0.9rem] leading-[1.7] text-[var(--muted)]">
              {state === 'paid'
                ? 'Thank you for your support. No further payment is needed.'
                : paymentAmount
                  ? 'Send the exact amount to this address. This address belongs to this donation.'
                  : 'Refresh the payment status before sending any further payment.'}
            </p>
          </div>
        </div>
        {partialDetails && (
          <p class="border-l-2 border-[var(--text)] pl-3 leading-[1.7]">
            {partialDetails}
            <br />
            Send the remaining amount to this same address.
          </p>
        )}
        <form method="get" action={`/donate/${id}`} class="mt-9">
          <button
            class="inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-normal rounded border border-[var(--border)] bg-transparent px-4 py-3 text-base leading-[1.4] font-medium text-[var(--text)] hover:border-[var(--text)] hover:bg-[var(--text)] hover:text-[var(--background)]"
            type="submit"
          >
            Refresh payment status
          </button>
        </form>
      </>
    )}
    {!donation && (
      <p class="max-w-[55ch] text-base leading-[1.7] text-[var(--muted)]">
        We couldn’t load this payment. Try refreshing the page in a moment.
      </p>
    )}
    <noscript>
      <p class="mt-6 text-[0.9rem] leading-[1.7] text-[var(--muted)]">
        Copy manually by selecting the amount or address.
      </p>
    </noscript>
  </main>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>('[data-copy]')
      .forEach((button) =>
        button.addEventListener('click', async () => {
          const target = document.getElementById(button.dataset.copy ?? '');
          if (!target) return;
          try {
            await navigator.clipboard.writeText(
              target.textContent?.trim() ?? '',
            );
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select and copy manually';
          }
        }),
      );
  </script>
</Layout>
