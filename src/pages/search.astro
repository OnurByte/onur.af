---
import * as stylex from '@stylexjs/stylex';
import Layout from '../layouts/Layout.astro';
import { styles } from '../styles/pages';
import { searchStyles } from '../styles/search';
import { searchPages } from '../portfolio/search';
import { publicPreview } from '../portfolio/previews';
const description = publicPreview('/search')!.description;
---

<Layout title="Search · Onur" description={description}>
  <main {...stylex.attrs(styles.main)}>
    <h1 {...stylex.attrs(styles.heading)}>Search</h1>
    <p {...stylex.attrs(styles.paragraph)} data-page-description>
      {description}
    </p>
    <form id="search-form" role="search" {...stylex.attrs(searchStyles.form)}>
      <label for="search-query">Search pages</label>
      <input
        {...stylex.attrs(styles.customInput)}
        id="search-query"
        type="search"
        maxlength="200"
        autocomplete="off"
      />
      <button {...stylex.attrs(styles.button, styles.primary)} type="submit">
        Search
      </button>
    </form>
    <p id="search-status" role="status" {...stylex.attrs(styles.paragraph)}></p>
    <ul id="search-results" {...stylex.attrs(searchStyles.results)}></ul>
    <noscript>
      <p>Enable JavaScript to search, or choose a page below.</p>
    </noscript>
    <nav aria-label="Public pages" {...stylex.attrs(styles.prose)}>
      <ul {...stylex.attrs(searchStyles.results)}>
        {searchPages.map(({ url, meta }) => (
          <li>
            <a href={url}>{meta.title}</a> — {meta.description}
          </li>
        ))}
      </ul>
    </nav>
  </main>
</Layout>
<script>
  import '../client/search';
</script>
