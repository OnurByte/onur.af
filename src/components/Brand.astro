---
---
<span class="brand"><span class="brand-mark" aria-hidden="true"><span class="brand-gradient"></span></span><span>Onur</span></span>

<script>
  const marks = [...document.querySelectorAll<HTMLElement>(".brand-mark")];
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const active = new Map<HTMLElement, Animation>();
  let generation = 0;

  const random = (min: number, max: number) => min + Math.random() * (max - min);
  const frame = () => ({
    transform: `translate(${random(-18, 18)}%, ${random(-18, 18)}%) rotate(${random(-24, 24)}deg) scale(${random(.82, 1.18)})`,
    filter: `blur(${random(0, 2)}px) hue-rotate(${random(0, 360)}deg) saturate(${random(.7, 1.8)})`,
    opacity: random(.82, 1),
  });

  async function drift(current: number) {
    while (current === generation && !motion.matches && marks.length) {
      const target = frame();
      const timing = {
        duration: random(3000, 8000),
        easing: `cubic-bezier(${random(.2, .4)}, ${random(.2, .4)}, ${random(.6, .8)}, ${random(.6, .8)})`,
        fill: "forwards" as FillMode,
      };
      const firstGradient = marks[0].firstElementChild as HTMLElement;
      const style = getComputedStyle(firstGradient);
      const from = { transform: style.transform, filter: style.filter, opacity: style.opacity };
      const animations = marks.map(mark => {
        const gradient = mark.firstElementChild as HTMLElement;
        const animation = gradient.animate([
          from,
          target,
        ], timing);
        active.set(mark, animation);
        return { mark, gradient, animation };
      });
      const startTime = document.timeline.currentTime ?? performance.now();
      animations.forEach(({ animation }) => (animation.startTime = startTime));
      const finished = await Promise.all(animations.map(({ animation }) =>
        animation.finished.then(() => true, () => false),
      ));
      if (finished.every(Boolean) && current === generation && !motion.matches) {
        animations.forEach(({ gradient }) => Object.assign(gradient.style, target));
        animations.forEach(({ animation }) => animation.cancel());
      }
      animations.forEach(({ mark, animation }) => {
        if (active.get(mark) === animation) active.delete(mark);
      });
    }
  }

  function updateMotion() {
    generation++;
    active.forEach(animation => animation.cancel());
    active.clear();
    if (motion.matches) marks.forEach(mark => (mark.firstElementChild as HTMLElement).removeAttribute("style"));
    if (!motion.matches) void drift(generation);
  }

  motion.addEventListener("change", updateMotion);
  updateMotion();
</script>
