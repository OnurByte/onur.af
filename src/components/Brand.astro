---
import * as stylex from '@stylexjs/stylex';
import { shell } from '../styles/shell';
---

<span {...stylex.attrs(shell.brand)}>
  <img
    src="/brand/onur.svg"
    width="56"
    height="56"
    {...stylex.attrs(shell.brandImage, shell.monochrome)}
    alt=""
    aria-hidden="true"
  />
  <span>Onur</span>
</span>
