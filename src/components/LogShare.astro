---
import * as stylex from '@stylexjs/stylex';
import { edge } from '../styles/edge';
import Icon from './Icon.astro';
import { dialogStyles } from '../styles/dialog';
import { searchStyles } from '../styles/search';
import { shareStyles } from '../styles/log-share';
import { styles } from '../styles/pages';
import { logUrl, logMetadata, type LogEntry } from '../portfolio/log';
import { siteOrigin } from '../portfolio/seo';
interface Props {
  entry: LogEntry;
}
const { entry } = Astro.props;
const title = logMetadata(entry).title;
const origin = siteOrigin(Astro.site) ?? Astro.url.origin;
const url = new URL(logUrl(entry), origin).href;
const rows = [
  {
    label: 'RSS',
    icon: 'shareRss',
    href: '/rss',
  },
  { label: 'Copy link', icon: 'shareLink', action: 'copy' },
  {
    label: 'X',
    icon: 'shareX',
    href: `https://twitter.com/intent/tweet?${new URLSearchParams({ text: title, url })}`,
  },
  {
    label: 'Discord',
    icon: 'discord',
    action: 'discord',
  },
  {
    label: 'Reddit',
    icon: 'reddit',
    href: `https://www.reddit.com/submit?${new URLSearchParams({ title, url })}`,
  },
  {
    label: 'Telegram',
    icon: 'telegram',
    href: `https://t.me/share/url?${new URLSearchParams({ url, text: title })}`,
  },
  {
    label: 'Mail',
    icon: 'shareMail',
    href: `mailto:?${new URLSearchParams({ subject: title, body: url }).toString().replaceAll('+', '%20')}`,
  },
  {
    label: 'More options',
    icon: 'share',
    action: 'native',
  },
] as const;
---

<div hidden {...stylex.attrs(shareStyles.triggerRow)}>
  <button
    id="open-share"
    type="button"
    aria-label="Share log"
    aria-haspopup="dialog"
    aria-controls="share-dialog"
    aria-keyshortcuts="Control+Shift"
    {...stylex.attrs(shareStyles.trigger)}
  >
    <span>Share</span>
    <kbd data-share-shortcut {...stylex.attrs(searchStyles.shortcut)}>
      Ctrl
      <Icon name="shift" />
    </kbd>
  </button>
</div>
<dialog
  id="share-dialog"
  aria-label="Share log"
  data-url={url}
  data-title={title}
  {...stylex.attrs(dialogStyles.dialog, edge.frame)}
>
  <form method="dialog">
    <button type="submit" {...stylex.attrs(dialogStyles.accessibleClose)}>
      Close share
    </button>
  </form>
  <ul {...stylex.attrs(searchStyles.results, shareStyles.results)}>
    {rows.map((row, index) => (
      <li
        hidden={'action' in row && row.action === 'native'}
        data-native-row={
          'action' in row && row.action === 'native' ? '' : undefined
        }
      >
        {'href' in row ? (
          <a
            href={row.href}
            target={
              index === 0 || row.href.startsWith('mailto:')
                ? undefined
                : '_blank'
            }
            rel={
              index === 0 || row.href.startsWith('mailto:')
                ? undefined
                : 'noopener noreferrer'
            }
            {...stylex.attrs(searchStyles.result)}
          >
            <span {...stylex.attrs(shareStyles.icon)}>
              <Icon name={row.icon} />
            </span>
            <span>{row.label}</span>
          </a>
        ) : (
          <button
            type="button"
            data-share-action={row.action}
            {...stylex.attrs(searchStyles.result, shareStyles.row)}
          >
            <span {...stylex.attrs(shareStyles.icon)}>
              <Icon name={row.icon} />
            </span>
            <span>{row.label}</span>
          </button>
        )}
      </li>
    ))}
  </ul>
  <p
    id="share-status"
    hidden
    role="status"
    {...stylex.attrs(searchStyles.status)}
  ></p>
</dialog>
<noscript>
  <div {...stylex.attrs(shareStyles.fallback)}>
    <a {...stylex.attrs(styles.walletLink)} href="/rss">
      RSS
    </a>{' '}
    ⁜{' '}
    <a {...stylex.attrs(styles.walletLink)} href={rows[2].href}>
      Share on X
    </a>{' '}
    ⁜{' '}
    <a {...stylex.attrs(styles.walletLink)} href={rows[4].href}>
      Share on Reddit
    </a>{' '}
    ⁜{' '}
    <a {...stylex.attrs(styles.walletLink)} href={rows[5].href}>
      Share on Telegram
    </a>
  </div>
</noscript>
<script>
  import '../client/log-share';
</script>
