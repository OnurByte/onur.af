---
import * as stylex from '@stylexjs/stylex';
import { logLayout } from '../styles/log-layout';
import { logStyles } from '../styles/log';
import { type LogEntry } from '../portfolio/log';
import { logRevisionDiff } from '../portfolio/log-diff';
interface Props {
  entry: LogEntry;
  version: number;
}
const { entry, version } = Astro.props;
const diff = logRevisionDiff(entry, version);
const lines = diff.hunks.flatMap((hunk) => [
  {
    kind: 'range',
    text: `@@ -${hunk.oldStart},${hunk.oldLines} +${hunk.newStart},${hunk.newLines} @@`,
  },
  ...hunk.lines.map((text) => ({
    kind: text.startsWith('+')
      ? 'added'
      : text.startsWith('-')
        ? 'removed'
        : 'context',
    text,
  })),
]);
---

{diff.hunks.length > 0 && (
  <details class:list={['log-diff', stylex.attrs(logLayout.diff).class]}>
    <summary {...stylex.attrs(logStyles.summary, logLayout.summary)}>
      Changes in v{version} ⁜ {diff.added} added, {diff.removed} removed
    </summary>
    <pre
      {...stylex.attrs(logLayout.diffCode)}
      tabindex="0"
      aria-label={`Changes from version ${version - 1} to ${version}`}
    ><code>{lines.map((line) => <span class:list={[`diff-${line.kind}`, stylex.attrs(logLayout.diffLine, line.kind === "range" && logLayout.diffRange, line.kind === "added" && logLayout.diffAdded, line.kind === "removed" && logLayout.diffRemoved).class]}>{line.text}{'\n'}</span>)}</code></pre>
  </details>
)}
