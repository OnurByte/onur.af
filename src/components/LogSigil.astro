---
import { logSigilSvg } from '../portfolio/log-sigil-svg';
const { id } = Astro.props;
---

<div class="log-sigil" set:html={logSigilSvg(id)} />
<style>
  .log-sigil {
    display: block;
    width: 100%;
    opacity: 0.86;
  }
  .log-sigil :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
