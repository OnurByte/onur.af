---
import * as stylex from '@stylexjs/stylex';
import { logContent } from '../styles/log-content';
import { logSigilSvg } from '../portfolio/log-sigil-svg';
const { id } = Astro.props;
---

<div
  class:list={['log-sigil', stylex.attrs(logContent.sigil).class]}
  set:html={logSigilSvg(
    id,
    'currentColor',
    `log-sigil ${stylex.attrs(logContent.sigilImage).class}`,
  )}
/>
