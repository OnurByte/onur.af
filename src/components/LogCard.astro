---
import * as stylex from '@stylexjs/stylex';
import { logStyles } from '../styles/log';
import {
  logMetadata,
  logProofUrl,
  logUrl,
  readingTime,
  type LogEntry,
} from '../portfolio/log';
import LogTags from './LogTags.astro';
import ProofBadge from './ProofBadge.astro';
import { edge } from '../styles/edge';
import LogSigil from './LogSigil.astro';
interface Props {
  entry: LogEntry;
  verified: boolean;
}
const { entry, verified } = Astro.props;
const metadata = logMetadata(entry);
const publishedAt = entry.revisions[0]!.publishedAt;
---

<article
  class:list={['h-entry', stylex.attrs(logStyles.entryCard, edge.frame).class]}
  id={entry.id}
>
  <h2
    class:list={['p-name', stylex.attrs(logStyles.title).class]}
    id={`${entry.id}-title`}
  >
    <a
      class:list={['u-url', stylex.attrs(logStyles.cardLink).class]}
      href={logUrl(entry)}
    >
      {metadata.title}
    </a>
  </h2>
  <div {...stylex.attrs(logStyles.meta)}>
    {verified ? (
      <a
        {...stylex.attrs(logStyles.cardBadge)}
        href={`${logProofUrl(entry)}#timestamps`}
        aria-label={`Timestamp proof for ${publishedAt.slice(0, 10)}`}
      >
        <time class="dt-published" datetime={publishedAt}>
          {publishedAt.slice(0, 10)}
        </time>
      </a>
    ) : (
      <time class="dt-published" datetime={publishedAt}>
        {publishedAt.slice(0, 10)}
      </time>
    )}
    {verified && (
      <ProofBadge
        target="log"
        href={logProofUrl(entry)}
        label="Verified"
        aboveCardLink
      />
    )}
    <span>{readingTime(entry.revisions.at(-1)!.body)}</span>
  </div>
  <p class:list={['p-summary', stylex.attrs(logStyles.excerpt).class]}>
    {metadata.summary}
  </p>
  <LogTags tags={metadata.tags} />
  <div {...stylex.attrs(logStyles.sigil)}>
    <LogSigil id={entry.id} />
  </div>
</article>
