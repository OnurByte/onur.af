---
import * as stylex from '@stylexjs/stylex';
import Icon from './Icon.astro';
import ProofBadge from './ProofBadge.astro';
import { embeds } from '../styles/embeds';
import { connect } from '../styles/connect';
import { identityAccounts } from '../portfolio/proofs';

// Publish only addresses explicitly configured by the site owner.
const email = import.meta.env['PUBLIC_CONTACT_EMAIL']?.trim();
const xmpp = import.meta.env['PUBLIC_CONTACT_XMPP']?.trim();
const contacts = [
  {
    label: 'Email',
    icon: 'shareMail',
    href: email ? `mailto:${email}` : undefined,
    detail: email,
  },
  {
    label: 'X',
    icon: 'shareX',
    href: identityAccounts.x.profile,
    detail: identityAccounts.x.name,
  },
  {
    label: 'GitHub',
    icon: 'connectGithub',
    href: identityAccounts.github.profile,
    detail: identityAccounts.github.name,
  },
  {
    label: 'XMPP',
    icon: 'xmpp',
    href: xmpp ? `xmpp:${xmpp}` : undefined,
    detail: xmpp,
  },
  { label: 'PGP', icon: 'connectKey', href: '/pgp', detail: 'Verify identity' },
] as const;
---

<section
  {...stylex.attrs(embeds.section, connect.section)}
  aria-labelledby="connect-heading"
>
  <h2 id="connect-heading" {...stylex.attrs(embeds.title)}>
    Connect
  </h2>
  <ul {...stylex.attrs(connect.list)}>
    {contacts.map((contact) => (
      <li
        id={
          contact.label === 'X'
            ? 'connect-x'
            : contact.label === 'GitHub'
              ? 'connect-github'
              : undefined
        }
        {...stylex.attrs(connect.item)}
      >
        {contact.label === 'X' || contact.label === 'GitHub' ? (
          <div {...stylex.attrs(connect.link, connect.accountRow)}>
            <Icon name={contact.icon} />
            <div {...stylex.attrs(connect.copy)}>
              <span>{contact.label}</span>
              <div {...stylex.attrs(connect.identity)}>
                <a
                  href={contact.href}
                  rel="me noreferrer"
                  {...stylex.attrs(connect.detail, connect.accountLink)}
                >
                  {contact.detail}
                </a>
                <span {...stylex.attrs(connect.proof)}>
                  <ProofBadge target={contact.label === 'X' ? 'x' : 'github'} />
                </span>
              </div>
            </div>
          </div>
        ) : contact.href ? (
          <a
            href={contact.href}
            rel={
              contact.href.startsWith('https:') ? 'me noreferrer' : undefined
            }
            {...stylex.attrs(connect.link)}
          >
            <Icon name={contact.icon} />
            <span {...stylex.attrs(connect.copy)}>
              <span>{contact.label}</span>
              <span {...stylex.attrs(connect.detail)}>{contact.detail}</span>
            </span>
          </a>
        ) : (
          <span {...stylex.attrs(connect.link, connect.unpublished)}>
            <Icon name={contact.icon} />
            <span {...stylex.attrs(connect.copy)}>
              <span>{contact.label}</span>
              <span {...stylex.attrs(connect.detail)}>Not published</span>
            </span>
          </span>
        )}
      </li>
    ))}
  </ul>
</section>
