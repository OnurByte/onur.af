---
import { logContent } from '../styles/log-content';
import { presentLogContent } from '../portfolio/log-presentation';
import Annotations from './Annotations.astro';
import { getLogSignatures } from '../portfolio/verified-signatures';
import LogSources from './LogSources.astro';
import 'katex/dist/katex.min.css';
import images from 'virtual:log-images';
import { applyLogImages } from '../portfolio/log-images';
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { logMetadata, type LogEntry } from '../portfolio/log';
import { renderLogContent } from '../portfolio/log-markdown';
interface Props {
  entry: LogEntry;
  version: number;
  archived?: boolean;
}
const { entry, version, archived = false } = Astro.props;
const revision = entry.revisions[version - 1]!;
const metadata = logMetadata(entry, version);
const content = renderLogContent(
  revision.body,
  archived ? `${entry.id}-v${version}-` : '',
  metadata.sources.length,
);
const revisionSignature = (await getLogSignatures())[`${entry.id}-v${version}`];
const coverImage = metadata.cover ? images[metadata.cover.src] : undefined;
---

{metadata.cover && (
  <figure class:list={['log-cover', stylex.attrs(logContent.cover).class]}>
    <img
      src={coverImage?.src ?? metadata.cover.src}
      srcset={coverImage?.srcset}
      sizes={coverImage?.sizes}
      alt={metadata.cover.alt}
      width={metadata.cover.width}
      height={metadata.cover.height}
      decoding="async"
      loading={archived ? 'lazy' : 'eager'}
    />
    {metadata.cover.caption && (
      <figcaption {...stylex.attrs(logContent.caption)}>
        {metadata.cover.caption}
      </figcaption>
    )}
  </figure>
)}

<div
  id={`${entry.id}-v${version}-body`}
  data-annotation-revision={version}
  data-scroll-headings={archived ? undefined : ''}
  data-scroll-archive={archived ? '' : undefined}
  lang={metadata.language}
  class:list={[
    'log-body',
    !archived && 'e-content',
    stylex.attrs(logContent.body).class,
  ]}
  set:html={presentLogContent(applyLogImages(content.html, images))}
/>
{revisionSignature && (
  <Annotations
    logId={entry.id}
    revision={version}
    revisionHash={revisionSignature.sha256}
  />
)}
<LogSources
  sources={metadata.sources}
  references={content.sourceReferences}
  prefix={archived ? `${entry.id}-v${version}-` : ''}
/>
<template data-log-code-copy>
  <div
    class:list={['log-code-block', stylex.attrs(logContent.codeBlock).class]}
  >
    <div {...stylex.attrs(styles.keyActions, logContent.codeActions)}>
      <button
        {...stylex.attrs(
          styles.button,
          styles.secondary,
          styles.compactAction,
          logContent.copyButton,
        )}
        type="button"
      >
        Copy
      </button>
    </div>
  </div>
</template>
