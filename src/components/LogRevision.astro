---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { type LogEntry } from '../portfolio/log';
import { renderLogMarkdown } from '../portfolio/log-markdown';
interface Props {
  entry: LogEntry;
  version: number;
  archived?: boolean;
}
const { entry, version, archived = false } = Astro.props;
const revision = entry.revisions[version - 1]!;
---

<div
  class:list={['log-body', !archived && 'e-content']}
  set:html={renderLogMarkdown(revision.body)}
/>
<template data-log-code-copy>
  <div class="log-code-block">
    <div {...stylex.attrs(styles.keyActions)}>
      <button
        {...stylex.attrs(styles.button, styles.secondary, styles.compactAction)}
        type="button"
      >
        Copy
      </button>
    </div>
  </div>
</template>
<style is:global>
  .log-code-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px;
  }
  .log-code-block > div {
    grid-column: 2;
    grid-row: 1;
    margin-top: 8px;
  }
  .log-code-block button {
    width: fit-content;
  }
  .log-code-block pre {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    margin-top: 8px;
  }

  .log-body {
    margin-top: 20px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .log-body > * + * {
    margin-top: 16px;
  }
  .log-body h2,
  .log-body h3 {
    font-size: 1.125rem;
    margin-top: 24px;
  }
  .log-body a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .log-body ul,
  .log-body ol {
    padding-left: 24px;
  }
  .log-body ul {
    list-style: disc;
  }
  .log-body ol {
    list-style: decimal;
  }
  .log-body pre {
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.875rem;
  }
  .log-body blockquote {
    border-left: 1px solid var(--border);
    padding-left: 16px;
  }
  .log-body img {
    max-width: 100%;
  }
</style>
