---
import * as stylex from '@stylexjs/stylex';
import type { HTMLAttributes } from 'astro/types';
import { identityAccounts } from '../portfolio/identity-accounts';
import { proof } from '../styles/proof';
import ProofBadge from './ProofBadge.astro';
interface Props extends HTMLAttributes<'a'> {
  account: keyof typeof identityAccounts;
  label?: string;
  showProofBadge?: boolean;
  wrapperAttributes?: HTMLAttributes<'span'>;
}
const {
  account,
  label,
  showProofBadge = true,
  wrapperAttributes = {},
  ...attributes
} = Astro.props;
const identity = identityAccounts[account];
const { class: wrapperClass, ...wrapperRest } = wrapperAttributes;
---

<span
  {...wrapperRest}
  class={[stylex.attrs(proof.identity).class, wrapperClass]
    .filter(Boolean)
    .join(' ')}
>
  <a {...attributes} href={attributes.href ?? `/pgp/${account}`}>
    {label ?? identity.name}
  </a>
  {showProofBadge && <ProofBadge target={account} />}
</span>
