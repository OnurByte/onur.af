---
import * as stylex from '@stylexjs/stylex';
import { searchStyles } from '../styles/search';
import { searchPages } from '../portfolio/search';
import SearchNetworks from './SearchNetworks.astro';
---

<button
  id="open-search"
  type="button"
  hidden
  aria-label="Search pages"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  aria-keyshortcuts="Control+K Meta+K"
  {...stylex.attrs(searchStyles.trigger)}
>
  <kbd {...stylex.attrs(searchStyles.shortcut)}>Ctrl K</kbd>
</button>
<dialog
  id="search-dialog"
  aria-label="Search pages"
  {...stylex.attrs(searchStyles.dialog)}
>
  <div {...stylex.attrs(searchStyles.top)}>
    <button
      id="close-search"
      type="button"
      aria-label="Close search"
      {...stylex.attrs(searchStyles.close)}
    >
      Esc
    </button>
  </div>
  <div {...stylex.attrs(searchStyles.field)}>
    <input
      id="search-query"
      type="search"
      aria-label="Search pages"
      placeholder="Where do you want to go?"
      maxlength="200"
      autocomplete="off"
      autofocus
      {...stylex.attrs(searchStyles.input)}
    />
  </div>
  <p
    id="search-status"
    role="status"
    hidden
    {...stylex.attrs(searchStyles.status)}
  ></p>
  <ul id="search-results" {...stylex.attrs(searchStyles.results)}>
    {searchPages.map(({ url, meta }) => (
      <li>
        <a href={url} {...stylex.attrs(searchStyles.result)}>
          <span data-result-title>{meta.title}</span>
          <small data-result-description {...stylex.attrs(searchStyles.detail)}>
            {meta.description}
          </small>
        </a>
      </li>
    ))}
    <SearchNetworks />
  </ul>
  <p {...stylex.attrs(searchStyles.hint)}>
    ↑ ↓ to navigate · Enter to open · Esc to close
  </p>
</dialog>
<script>
  import '../client/search';
</script>
