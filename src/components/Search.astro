---
import * as stylex from '@stylexjs/stylex';
import { edge } from '../styles/edge';
import { dialogStyles } from '../styles/dialog';
import { searchStyles } from '../styles/search';
import { searchEntries } from '../portfolio/search';
import SearchNetworks from './SearchNetworks.astro';
const groups = [
  searchEntries.filter(({ url }) => !url.startsWith('/log/')),
  searchEntries.filter(({ url }) => url.startsWith('/log/')),
];
---

<button
  id="open-search"
  type="button"
  hidden
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  aria-keyshortcuts="Control+K Meta+K"
  {...stylex.attrs(searchStyles.trigger)}
>
  <i
    aria-hidden="true"
    {...stylex.attrs(searchStyles.triggerBorder, edge.ring)}
  ></i>
  <span>Find</span>
  <kbd {...stylex.attrs(searchStyles.shortcut)}>Ctrl K</kbd>
</button>
<dialog
  id="search-dialog"
  aria-label="Search pages"
  {...stylex.attrs(dialogStyles.dialog, edge.frame)}
>
  <form method="dialog">
    <button type="submit" {...stylex.attrs(dialogStyles.accessibleClose)}>
      Close search
    </button>
  </form>
  <div {...stylex.attrs(searchStyles.field)}>
    <input
      id="search-query"
      type="search"
      aria-label="Search pages"
      placeholder="Where to?"
      maxlength="200"
      autocomplete="off"
      autofocus
      {...stylex.attrs(searchStyles.input)}
    />
  </div>
  <p
    id="search-status"
    role="status"
    hidden
    {...stylex.attrs(searchStyles.status)}
  ></p>
  <ul id="search-results" {...stylex.attrs(searchStyles.results)}>
    {groups.map((entries, group) => (
      <>
        {entries.map(({ url, meta, searchText }) => (
          <li data-search-text={searchText}>
            <a href={url} {...stylex.attrs(searchStyles.result)}>
              <span data-result-title>{meta.title}</span>
              <small
                data-result-description
                {...stylex.attrs(searchStyles.detail)}
              >
                {meta.description}
              </small>
            </a>
          </li>
        ))}
        {group === 0 && <SearchNetworks />}
      </>
    ))}
  </ul>
</dialog>
<script>
  import '../client/search';
</script>
