---
import * as stylex from '@stylexjs/stylex';
import { shell } from '../styles/shell';
import tor from '../../public/brand/tor.svg?raw';
import i2p from '../../public/brand/i2p.svg?raw';

interface Props {
  network: 'TOR' | 'I2P';
}
const { network } = Astro.props;
const iconAttrs = stylex.attrs(
  shell.network,
  shell.monochrome,
  network === 'I2P' ? shell.i2p : shell.tor,
);
const icon =
  network === 'TOR'
    ? tor
    : i2p.replace(/\.st([0-3])\{/g, '.network-icon[data-network="I2P"] .st$1{');
---

<span
  class:list={['network-icon', iconAttrs.class]}
  data-network={network}
  aria-hidden="true"
  set:html={icon.slice(icon.indexOf('<svg'))}
/>
