---
import * as stylex from '@stylexjs/stylex';
import { logLayout } from '../styles/log-layout';
import { styles } from '../styles/pages';
import { logStyles } from '../styles/log';
import {
  logMetadata,
  logProofUrl,
  logUrl,
  readingTime,
  type LogEntry,
} from '../portfolio/log';
import { getLogSignatures } from '../portfolio/verified-proofs';
import { buildContentIndex } from '../portfolio/content-index';
import { logConnections } from '../portfolio/log-connections';
import { siteOrigin } from '../portfolio/seo';
import LogShare from './LogShare.astro';
import LogDiff from './LogDiff.astro';
import LogRevision from './LogRevision.astro';
import LogTags from './LogTags.astro';
import ProofBadge from './ProofBadge.astro';
import LogSigil from './LogSigil.astro';
interface Props {
  entry: LogEntry;
}
const { entry } = Astro.props;
const href = logUrl(entry);
const metadata = logMetadata(entry);
const signatures = await getLogSignatures();
const latest = entry.revisions.at(-1)!;
const origin = siteOrigin(Astro.site);
const references = buildContentIndex([entry], origin).documents[0]!
  .repositories;
const connections = logConnections(entry, undefined, origin);
const date = (value: string) => new Date(value).toISOString().slice(0, 10);
---

<article
  id={entry.id}
  class:list={['h-entry', stylex.attrs(logLayout.article).class]}
  data-log-version={latest.version}
>
  <link class="u-url" href={origin ? new URL(href, origin).href : href} />
  <header class:list={['log-heading', stylex.attrs(logLayout.heading).class]}>
    <h1
      {...stylex.attrs(logStyles.title, styles.heading, logLayout.headingTitle)}
    >
      <span class="p-name">{metadata.title}</span>
    </h1>
    <div
      class:list={['log-heading-sigil', stylex.attrs(logLayout.sigil).class]}
    >
      <LogSigil id={entry.id} />
    </div>
  </header>
  <div {...stylex.attrs(logStyles.meta)}>
    <a
      href={`${logProofUrl(entry, entry.revisions[0]!.version)}#timestamps`}
      aria-label={`Timestamp proof for ${date(entry.revisions[0]!.publishedAt)}`}
    >
      <time
        class="dt-published"
        datetime={entry.revisions[0]!.publishedAt}
        title={entry.revisions[0]!.publishedAt}
      >
        {date(entry.revisions[0]!.publishedAt)}
      </time>
    </a>

    {signatures[`${entry.id}-v${latest.version}`] && (
      <ProofBadge target="log" href={logProofUrl(entry)} label="Verified" />
    )}
    <span class="p-author h-card">
      By{' '}
      <a class="p-name u-url" href={origin ? `${origin}/` : '/'}>
        Onur
      </a>
    </span>
    <span>{readingTime(latest.body)}</span>
    {latest.version > 1 && (
      <a
        href={`${logProofUrl(entry, latest.version)}#timestamps`}
        aria-label={`Timestamp proof for revision ${latest.version}, ${date(latest.publishedAt)}`}
      >
        <time
          class="dt-updated"
          datetime={latest.publishedAt}
          title={`Updated ${latest.publishedAt}`}
        >
          v{latest.version} ⁜ {date(latest.publishedAt)}
        </time>
      </a>
    )}
    <LogShare entry={entry} />
  </div>
  <LogTags tags={metadata.tags} />
  <LogRevision entry={entry} version={latest.version} />
  {latest.version > 1 && (
    <details {...stylex.attrs(logStyles.details)}>
      <summary {...stylex.attrs(logStyles.summary)}>History</summary>
      <LogDiff entry={entry} version={latest.version} />
      {entry.revisions
        .slice(0, -1)
        .toReversed()
        .map((revision) => (
          <section
            id={`${entry.id}-v${revision.version}`}
            {...stylex.attrs(logStyles.proof)}
          >
            <h2 {...stylex.attrs(logStyles.proofTitle)}>
              v{revision.version} ⁜{' '}
              <time
                datetime={revision.publishedAt}
                title={revision.publishedAt}
              >
                {date(revision.publishedAt)}
              </time>
            </h2>
            <LogDiff entry={entry} version={revision.version} />
            <LogRevision entry={entry} version={revision.version} archived />
            {signatures[`${entry.id}-v${revision.version}`] && (
              <div {...stylex.attrs(logStyles.links)}>
                <ProofBadge
                  target="log"
                  href={logProofUrl(entry, revision.version)}
                  label="Verified"
                />
              </div>
            )}
          </section>
        ))}
    </details>
  )}
  {references.length > 0 && (
    <nav
      class:list={[
        'log-connections',
        stylex.attrs(logLayout.connections).class,
      ]}
      aria-label="Referenced code"
    >
      <h2 {...stylex.attrs(logLayout.connectionHeading)}>Referenced code</h2>
      <ul {...stylex.attrs(logLayout.list)}>
        {references.map((reference) => (
          <li>
            <a
              {...stylex.attrs(logLayout.link)}
              href={reference.url}
              rel="noreferrer"
            >
              {reference.repository}
              {reference.commit ? ` ⁜ ${reference.commit.slice(0, 12)}` : ''}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {connections.related.length > 0 && (
    <nav
      class:list={[
        'log-connections',
        stylex.attrs(logLayout.connections).class,
      ]}
      aria-label="Further reading"
    >
      <h2 {...stylex.attrs(logLayout.connectionHeading)}>Further reading</h2>
      <ul {...stylex.attrs(logLayout.list)}>
        {connections.related.map((related) => (
          <li>
            <a {...stylex.attrs(logLayout.link)} href={logUrl(related)}>
              {logMetadata(related).title}
            </a>
            {'reason' in related && <p>{related.reason}</p>}
          </li>
        ))}
      </ul>
    </nav>
  )}
  {connections.referencedBy.length > 0 && (
    <nav
      class:list={[
        'log-connections',
        stylex.attrs(logLayout.connections).class,
      ]}
      aria-label="Referenced by"
    >
      <h2 {...stylex.attrs(logLayout.connectionHeading)}>Referenced by</h2>
      <ul {...stylex.attrs(logLayout.list)}>
        {connections.referencedBy.map((related) => (
          <li>
            <a {...stylex.attrs(logLayout.link)} href={logUrl(related)}>
              {logMetadata(related).title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</article>
