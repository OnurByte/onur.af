---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/pages';
import { logStyles } from '../styles/log';
import AccountLink from './AccountLink.astro';
import ProofBadge from './ProofBadge.astro';
import { identityAccounts } from '../portfolio/identity-accounts';
import { listedLogEntries, logProofUrl, logMetadata } from '../portfolio/log';
import { getLogSignatures } from '../portfolio/verified-signatures';
const signatures = await getLogSignatures();
---

<div {...stylex.attrs(styles.prose)}>
  {(Object.keys(identityAccounts) as Array<keyof typeof identityAccounts>)
    .map((id) => [id, identityAccounts[id]] as const)
    .map(([id, account]) => (
      <section
        id={id}
        {...stylex.attrs(logStyles.proof)}
        aria-labelledby={`${id}-title`}
      >
        <h2
          id={`${id}-title`}
          data-scroll-section
          {...stylex.attrs(logStyles.proofTitle)}
        >
          <a href={`/pgp/${id}`}>{account.label}</a>
        </h2>
        <div {...stylex.attrs(logStyles.links)}>
          <AccountLink account={id} {...stylex.attrs(styles.walletLink)} />
        </div>
      </section>
    ))}
  <section
    id="log"
    {...stylex.attrs(logStyles.proof)}
    aria-labelledby="log-title"
  >
    <h2
      id="log-title"
      data-scroll-section
      {...stylex.attrs(logStyles.proofTitle)}
    >
      Log
    </h2>
    {listedLogEntries.length > 0 ? (
      <ul {...stylex.attrs(logStyles.registryList)}>
        {listedLogEntries.map((entry) => {
          const latest = entry.revisions.at(-1)!;
          const proofUrl = logProofUrl(entry);
          return (
            <li {...stylex.attrs(logStyles.registryEntry)}>
              <a {...stylex.attrs(logStyles.registryTitle)} href={proofUrl}>
                {logMetadata(entry).title}
              </a>
              <div {...stylex.attrs(logStyles.registryMeta)}>
                <time datetime={entry.revisions[0]!.publishedAt}>
                  {entry.revisions[0]!.publishedAt.slice(0, 10)}
                </time>
                {signatures[`${entry.id}-v${latest.version}`] && (
                  <ProofBadge target="log" href={proofUrl} label="Verified" />
                )}
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <p {...stylex.attrs(styles.paragraph)}>No signed Log entries.</p>
    )}
  </section>
</div>
