---
import * as stylex from '@stylexjs/stylex';
import { logStyles } from '../styles/log';
import Icon from './Icon.astro';
import { proof } from '../styles/proof';
interface Props {
  target: 'x' | 'github' | 'log';
  href?: string;
  label?: string;
  aboveCardLink?: boolean;
}
const { target, href, label, aboveCardLink } = Astro.props;
---

<a
  {...stylex.attrs(
    proof.badge,
    label ? proof.labeled : undefined,
    aboveCardLink ? logStyles.cardBadge : undefined,
  )}
  href={href ?? `/pgp/${target}`}
  aria-label={`${target === 'log' ? 'Publication' : target === 'x' ? 'X identity' : 'GitHub identity'} PGP proof${label ? ` ⁜ ${label}` : ''}`}
>
  {label && <span {...stylex.attrs(proof.label)}>{label}</span>}
  <Icon name="proof" />
</a>
