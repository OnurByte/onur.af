---
import * as stylex from '@stylexjs/stylex';
import { portfolioLinks } from '../portfolio/links';
import { searchStyles } from '../styles/search';
---

{portfolioLinks().map(({ label, href }) => (
  <li data-network-label={label}>
    {href ? (
      <a href={href} rel="noreferrer" {...stylex.attrs(searchStyles.result)}>
        <span data-result-title>{label}</span>
        <small data-result-description {...stylex.attrs(searchStyles.detail)}>
          {label === 'TOR' ? 'Browse via Tor.' : 'Browse via I2P.'}
        </small>
      </a>
    ) : (
      <span
        role="link"
        aria-disabled="true"
        {...stylex.attrs(searchStyles.result, searchStyles.unavailable)}
      >
        <span data-result-title>{label}</span>
        <small data-result-description {...stylex.attrs(searchStyles.detail)}>
          Not published yet.
        </small>
      </span>
    )}
  </li>
))}
