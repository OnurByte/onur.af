---
import * as stylex from '@stylexjs/stylex';
import { shell } from '../styles/shell';

const icons = {
  techJavascript: { filename: 'javascript.svg', width: 24, height: 24 },
  techTypescript: { filename: 'typescript.svg', width: 24, height: 24 },
  techPython: { filename: 'technologies/python.svg', width: 24, height: 24 },
  techGnubash: { filename: 'technologies/gnubash.svg', width: 24, height: 24 },
  techRust: { filename: 'rust.svg', width: 24, height: 24 },
  techGo: { filename: 'technologies/go.svg', width: 24, height: 24 },
  techOpenjdk: { filename: 'technologies/openjdk.svg', width: 24, height: 24 },
  techPhp: { filename: 'technologies/php.svg', width: 24, height: 24 },
  techLua: { filename: 'technologies/lua.svg', width: 24, height: 24 },
  techHtml5: { filename: 'technologies/html5.svg', width: 24, height: 24 },
  techCss: { filename: 'technologies/css.svg', width: 24, height: 24 },
  techAstro: { filename: 'technologies/astro.svg', width: 24, height: 24 },
  techNextdotjs: {
    filename: 'technologies/nextdotjs.svg',
    width: 24,
    height: 24,
  },
  techReact: { filename: 'technologies/react.svg', width: 24, height: 24 },
  techTailwindcss: {
    filename: 'technologies/tailwindcss.svg',
    width: 24,
    height: 24,
  },
  techShadcnui: {
    filename: 'technologies/shadcnui.svg',
    width: 24,
    height: 24,
  },
  techLinux: { filename: 'technologies/linux.svg', width: 24, height: 24 },
  techGit: { filename: 'technologies/git.svg', width: 24, height: 24 },
  techNixos: { filename: 'technologies/nixos.svg', width: 24, height: 24 },
  techNeovim: { filename: 'technologies/neovim.svg', width: 24, height: 24 },
  techZedindustries: {
    filename: 'technologies/zedindustries.svg',
    width: 24,
    height: 24,
  },
  techJetbrains: {
    filename: 'technologies/jetbrains.svg',
    width: 24,
    height: 24,
  },
  techNodedotjs: {
    filename: 'technologies/nodedotjs.svg',
    width: 24,
    height: 24,
  },
  techBun: { filename: 'technologies/bun.svg', width: 24, height: 24 },
  techGtk: { filename: 'technologies/gtk.svg', width: 24, height: 24 },
  techGnome: { filename: 'technologies/gnome.svg', width: 24, height: 24 },
  techSqlite: { filename: 'technologies/sqlite.svg', width: 24, height: 24 },
  techMysql: { filename: 'technologies/mysql.svg', width: 24, height: 24 },
  techPostgresql: {
    filename: 'technologies/postgresql.svg',
    width: 24,
    height: 24,
  },
  techDrizzle: { filename: 'technologies/drizzle.svg', width: 24, height: 24 },
  techCodex: { filename: 'technologies/codex.svg', width: 24, height: 24 },
  techClaude: { filename: 'technologies/claude.svg', width: 24, height: 24 },
  techModelcontextprotocol: {
    filename: 'technologies/modelcontextprotocol.svg',
    width: 24,
    height: 24,
  },

  connectMail: { filename: 'connect-mail.svg', width: 24, height: 24 },
  connectGithub: { filename: 'github.svg', width: 24, height: 24 },
  connectKey: { filename: 'search-key.svg', width: 24, height: 24 },
  xmpp: { filename: 'xmpp.svg', width: 24, height: 24 },
  shareMark: { filename: 'share-mark.svg', width: 16, height: 16 },
  shareX: { filename: 'x.svg', width: 24, height: 24 },
  shareRss: { filename: 'rss.svg', width: 24, height: 24 },
  discord: { filename: 'discord.svg', width: 24, height: 24 },
  reddit: { filename: 'reddit.svg', width: 24, height: 24 },
  telegram: { filename: 'telegram.svg', width: 24, height: 24 },
  share: { filename: 'share.svg', width: 24, height: 24 },
  shareLink: { filename: 'share-link.svg', width: 24, height: 24 },
  shareMail: { filename: 'share-mail.svg', width: 24, height: 24 },
  proof: { filename: 'proof.svg', width: 16, height: 16 },
  shift: { filename: 'shift.svg', width: 16, height: 16 },
  onur: { filename: 'onur.svg', width: 56, height: 56 },
  tor: { filename: 'tor.svg', width: 32, height: 32 },
  i2p: { filename: 'i2p.svg', width: 64, height: 32 },
  searchI2p: { filename: 'i2p.svg', width: 32, height: 32 },
  x: { filename: 'x.svg', width: 52, height: 52 },
  spotify: { filename: 'spotify.svg', width: 52, height: 52 },
  github: { filename: 'github.svg', width: 52, height: 52 },
  rust: { filename: 'rust.svg', width: 16, height: 16 },
  typescript: { filename: 'typescript.svg', width: 16, height: 16 },
  javascript: { filename: 'javascript.svg', width: 16, height: 16 },
  heart: { filename: 'heart.svg', width: 16, height: 16 },
  repost: { filename: 'repost.svg', width: 16, height: 16 },
  chevronDown: { filename: 'chevron-down.svg', width: 16, height: 16 },
  rss: { filename: 'rss.svg', width: 32, height: 32 },
  search: { filename: 'search.svg', width: 32, height: 32 },
  searchHome: { filename: 'search-home.svg', width: 32, height: 32 },
  searchDonate: { filename: 'search-donate.svg', width: 32, height: 32 },
  searchKey: { filename: 'search-key.svg', width: 32, height: 32 },
} as const;

interface Props {
  name: keyof typeof icons;
}
const { name } = Astro.props;
const { filename, width, height } = icons[name];
---

<img
  src={`/brand/${filename}`}
  width={width}
  height={height}
  {...stylex.attrs(
    shell.icon,
    shell.monochrome,
    (name.startsWith('tech') ||
      name.startsWith('share') ||
      name === 'connectMail' ||
      name === 'connectGithub' ||
      name === 'connectKey' ||
      name === 'xmpp' ||
      name === 'discord' ||
      name === 'reddit' ||
      name === 'telegram') &&
      shell.shareIcon,
    (name === 'x' || name === 'github' || name === 'spotify') &&
      shell.providerIcon,
    (name === 'shareMark' ||
      name === 'proof' ||
      name === 'shift' ||
      name === 'rust' ||
      name === 'typescript' ||
      name === 'javascript' ||
      name === 'chevronDown' ||
      name === 'heart' ||
      name === 'repost') &&
      shell.smallIcon,
    name === 'onur' && shell.brandIcon,
    name === 'i2p' && shell.wideIcon,
  )}
  data-icon={name}
  alt=""
  aria-hidden="true"
/>
