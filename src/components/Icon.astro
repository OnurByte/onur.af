---
import * as stylex from '@stylexjs/stylex';
import { shell } from '../styles/shell';

const icons = {
  onur: { filename: 'onur.svg', width: 56, height: 56 },
  tor: { filename: 'tor.svg', width: 32, height: 32 },
  i2p: { filename: 'i2p.svg', width: 64, height: 32 },
  searchI2p: { filename: 'i2p.svg', width: 32, height: 32 },
  x: { filename: 'x.svg', width: 52, height: 52 },
  spotify: { filename: 'spotify.svg', width: 52, height: 52 },
  github: { filename: 'github.svg', width: 52, height: 52 },
  rust: { filename: 'rust.svg', width: 16, height: 16 },
  typescript: { filename: 'typescript.svg', width: 16, height: 16 },
  javascript: { filename: 'javascript.svg', width: 16, height: 16 },
  heart: { filename: 'heart.svg', width: 16, height: 16 },
  repost: { filename: 'repost.svg', width: 16, height: 16 },
  chevronDown: { filename: 'chevron-down.svg', width: 16, height: 16 },
  rss: { filename: 'rss.svg', width: 32, height: 32 },
  search: { filename: 'search.svg', width: 32, height: 32 },
  searchHome: { filename: 'search-home.svg', width: 32, height: 32 },
  searchDonate: { filename: 'search-donate.svg', width: 32, height: 32 },
  searchKey: { filename: 'search-key.svg', width: 32, height: 32 },
} as const;

interface Props {
  name: keyof typeof icons;
}
const { name } = Astro.props;
const { filename, width, height } = icons[name];
---

<img
  src={`/brand/${filename}`}
  width={width}
  height={height}
  {...stylex.attrs(
    shell.icon,
    shell.monochrome,
    (name === 'x' || name === 'github' || name === 'spotify') &&
      shell.providerIcon,
    (name === 'rust' ||
      name === 'typescript' ||
      name === 'javascript' ||
      name === 'chevronDown' ||
      name === 'heart' ||
      name === 'repost') &&
      shell.smallIcon,
    name === 'onur' && shell.brandIcon,
    name === 'i2p' && shell.wideIcon,
  )}
  data-icon={name}
  alt=""
  aria-hidden="true"
/>
