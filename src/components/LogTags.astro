---
import { logTagDefinitions } from '../portfolio/log';
import { logTagUrl } from '../portfolio/log-tags';
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <nav class="log-tags" aria-label="Subjects">
    {tags.map((tag) => (
      <a href={logTagUrl(tag)} rel="tag" class="p-category">
        #{logTagDefinitions[tag]!.title}
      </a>
    ))}
  </nav>
)}
<style>
  .log-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
    position: relative;
    z-index: 1;
    font-size: 0.875rem;
  }
  .log-tags a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-style: italic;
    text-decoration: none;
  }
</style>
