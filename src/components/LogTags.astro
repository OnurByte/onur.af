---
import * as stylex from '@stylexjs/stylex';
import { logLayout } from '../styles/log-layout';
import { logTagDefinitions } from '../portfolio/log';
import { logTagUrl } from '../portfolio/log-tags';
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <nav
    class:list={['log-tags', stylex.attrs(logLayout.tags).class]}
    aria-label="Subjects"
  >
    {tags.map((tag) => (
      <a
        href={logTagUrl(tag)}
        rel="tag"
        class:list={['p-category', stylex.attrs(logLayout.tag).class]}
      >
        #{logTagDefinitions[tag]!.title}
      </a>
    ))}
  </nav>
)}
