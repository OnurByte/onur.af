---
import * as stylex from '@stylexjs/stylex';
import { edge } from '../../styles/edge';
import Icon from '../Icon.astro';
import { embeds as styles, recentMarker } from '../../styles/embeds';
import type { Embed } from '../../portfolio/embeds';
interface Props {
  embed: Embed;
}
const { embed } = Astro.props;
const recent = embed.recentTracks ?? [];
const track = embed.items.find((item) => item.kind === 'track');
const playback = track?.playback;
const duration = playback ? playback.endsAt - playback.startedAt : 1;
const elapsed = playback
  ? Math.max(0, Math.min(duration, Date.now() - playback.startedAt))
  : 0;
const time = (ms: number) =>
  `${Math.floor(ms / 60000)}:${String(Math.floor(ms / 1000) % 60).padStart(2, '0')}`;
---

<section
  id="spotify-embed"
  data-nosnippet
  {...stylex.attrs(styles.section, edge.frame, styles.spotifySection)}
  aria-labelledby="embed-spotify"
>
  <div {...stylex.attrs(styles.spotifyTop)}>
    <header {...stylex.attrs(styles.header)}>
      <div {...stylex.attrs(styles.identity)}>
        <Icon name="spotify" />
        <div {...stylex.attrs(styles.headingGroup)}>
          <h2
            id="embed-spotify"
            data-scroll-section
            {...stylex.attrs(styles.title)}
          >
            {track
              ? 'Listening'
              : embed.playbackState === 'idle'
                ? 'Playing nothing'
                : 'Spotify'}
          </h2>
          <span
            data-spotify-label
            {...stylex.attrs(styles.sourceLink)}
            hidden={!track && embed.playbackState !== 'idle'}
          >
            Spotify
          </span>
        </div>
      </div>
    </header>
    <div
      data-spotify-current
      {...stylex.attrs(styles.spotifyContent)}
      hidden={!embed.items.length}
    >
      <ul {...stylex.attrs(styles.list)} hidden={!embed.items.length}>
        {embed.items.map((track) => (
          <li {...stylex.attrs(styles.recentItem)}>
            <a
              {...stylex.attrs(styles.link)}
              href={track.href}
              rel="noreferrer"
            >
              {track.title}
            </a>
            {track.detail && (
              <span {...stylex.attrs(styles.detail)}>{track.detail}</span>
            )}
          </li>
        ))}
      </ul>
      <div
        data-spotify-progress
        {...stylex.attrs(styles.spotifyProgress)}
        data-start={playback?.startedAt}
        data-end={playback?.endsAt}
        hidden={!playback}
      >
        <progress
          {...stylex.attrs(styles.progressBar)}
          max={duration}
          value={elapsed}
          aria-label="Track progress"
          aria-valuetext={`${time(elapsed)} of ${time(duration)}`}
        ></progress>
        <div {...stylex.attrs(styles.progressTimes)}>
          <span data-spotify-elapsed>{time(elapsed)}</span>
          <span data-spotify-duration>{time(duration)}</span>
        </div>
      </div>
    </div>
    <button
      type="button"
      data-spotify-toggle
      {...stylex.attrs(styles.spotifyToggle, recentMarker)}
      aria-label="Show recent tracks"
      aria-expanded="false"
      aria-controls="spotify-recent"
      hidden={!recent.length}
    >
      <span {...stylex.attrs(styles.recentArrow)}>
        <Icon name="chevronDown" />
      </span>
    </button>
  </div>
  <div
    id="spotify-recent"
    data-spotify-recent
    {...stylex.attrs(styles.spotifyRecent)}
    hidden
  >
    <h3 {...stylex.attrs(styles.recentHeading)}>Recent</h3>
    <ol {...stylex.attrs(styles.list, styles.recentList)}>
      {recent.map((track) => (
        <li {...stylex.attrs(styles.recentItem)}>
          <a {...stylex.attrs(styles.link)} href={track.href} rel="noreferrer">
            {track.title}
          </a>
          {track.detail && (
            <span {...stylex.attrs(styles.detail)}>{track.detail}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
  {recent.length > 0 && (
    <noscript>
      <details {...stylex.attrs(styles.spotifyRecent)}>
        <summary {...stylex.attrs(styles.moreSummary)}>Recent tracks</summary>
        <ol {...stylex.attrs(styles.list, styles.recentList)}>
          {recent.map((track) => (
            <li {...stylex.attrs(styles.recentItem)}>
              <a
                {...stylex.attrs(styles.link)}
                href={track.href}
                rel="noreferrer"
              >
                {track.title}
              </a>
              {track.detail && (
                <span {...stylex.attrs(styles.detail)}>{track.detail}</span>
              )}
            </li>
          ))}
        </ol>
      </details>
    </noscript>
  )}
  <p
    data-spotify-health
    {...stylex.attrs(styles.meta)}
    hidden={embed.status !== 'stale' && embed.status !== 'unavailable'}
  >
    {embed.status === 'stale'
      ? 'Source unavailable; showing saved data.'
      : 'This source is currently unavailable.'}
  </p>
  <template data-spotify-track-template>
    <li {...stylex.attrs(styles.recentItem)}>
      <a {...stylex.attrs(styles.link)} rel="noreferrer"></a>
      <span {...stylex.attrs(styles.detail)}></span>
    </li>
  </template>
</section>
<script>
  import '../../client/spotify';
</script>
