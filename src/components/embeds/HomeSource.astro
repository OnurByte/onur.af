---
import HomeEmbeds from './HomeEmbeds.astro';
import { homeEmbedSources } from '../../content/home-embeds';
import { loadEmbeds } from '../../portfolio/embed-sources';
interface Props {
  sourceId: string;
}
const source = homeEmbedSources.find(
  (source) => source.id === Astro.props.sourceId,
);
if (!source) throw new Error('Unknown activity source');
Astro.response.headers.set('Cache-Control', 'no-store');
const embeds = await loadEmbeds([source], { timeoutMs: 15_000 });
---

<HomeEmbeds embeds={embeds} />
