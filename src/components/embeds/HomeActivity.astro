---
import * as stylex from '@stylexjs/stylex';
import { embeds as styles } from '../../styles/embeds';
import { homeEmbedFallbacks } from '../../content/home-embeds';
import HomeSource from './HomeSource.astro';
import HomeEmbeds from './HomeEmbeds.astro';
const fallbacks = await homeEmbedFallbacks();
---

<div {...stylex.attrs(styles.grid)}>
  {fallbacks.map((embed) =>
    embed.id === 'spotify' ? (
      <HomeEmbeds embeds={[embed]} />
    ) : (
      <HomeSource sourceId={embed.id} server:defer>
        <HomeEmbeds slot="fallback" embeds={[embed]} />
      </HomeSource>
    ),
  )}
</div>
