---
import * as stylex from '@stylexjs/stylex';
import { edge } from '../../styles/edge';
import { embeds as styles } from '../../styles/embeds';
import Icon from '../Icon.astro';
import AccountLink from '../AccountLink.astro';
import SpotifyEmbed from './SpotifyEmbed.astro';
import EmbedItem from './EmbedItem.astro';
import type { Embed } from '../../portfolio/embeds';
interface Props {
  embeds: readonly Embed[];
}
const { embeds } = Astro.props;
const spotifyEmbed = embeds.find((embed) => embed.id === 'spotify');
const messages = {
  empty: 'Nothing to show yet.',
  unavailable: 'This source is currently unavailable.',
};
---

{embeds.length > 0 && (
  <div {...stylex.attrs(styles.grid)}>
    {embeds
      .filter((embed) => embed.id !== 'spotify')
      .map((embed) => (
        <section
          {...stylex.attrs(
            styles.section,
            edge.frame,
            (embed.id === 'x' || embed.id === 'github') &&
              styles.activitySection,
          )}
          aria-labelledby={`embed-${embed.id}`}
        >
          <header {...stylex.attrs(styles.header)}>
            <div {...stylex.attrs(styles.identity)}>
              {(embed.id === 'x' || embed.id === 'github') && (
                <Icon name={embed.id} />
              )}
              <div {...stylex.attrs(styles.headingGroup)}>
                <h2
                  id={`embed-${embed.id}`}
                  data-scroll-section
                  {...stylex.attrs(styles.title)}
                >
                  {embed.title}
                </h2>
                {embed.id === 'x' || embed.id === 'github' ? (
                  <AccountLink
                    account={embed.id}
                    {...stylex.attrs(styles.link)}
                    wrapperAttributes={stylex.attrs(styles.sourceIdentity)}
                    rel="noreferrer"
                  />
                ) : (
                  <a
                    {...stylex.attrs(styles.link, styles.sourceLink)}
                    href={embed.href}
                    rel="noreferrer"
                  >
                    {embed.source}
                  </a>
                )}
              </div>
            </div>
          </header>
          {(embed.status === 'empty' || embed.status === 'unavailable') && (
            <p {...stylex.attrs(styles.meta)}>{messages[embed.status]}</p>
          )}
          {embed.status === 'stale' && (
            <p {...stylex.attrs(styles.meta)}>
              Source unavailable; showing saved data.
            </p>
          )}
          {embed.items.length > 0 && (
            <ul
              {...stylex.attrs(
                styles.list,
                (embed.id === 'x' || embed.id === 'github') &&
                  styles.activityList,
              )}
            >
              {embed.items.slice(0, 2).map((item) => (
                <EmbedItem item={item} />
              ))}
            </ul>
          )}
          {embed.items.length > 2 && (
            <details {...stylex.attrs(styles.more)}>
              <summary {...stylex.attrs(styles.moreSummary)}>
                Show more
                <span {...stylex.attrs(styles.srOnly)}>
                  {' '}
                  {embed.title.toLowerCase()}
                </span>
              </summary>
              <ul {...stylex.attrs(styles.list, styles.activityList)}>
                {embed.items.slice(2).map((item) => (
                  <EmbedItem item={item} />
                ))}
              </ul>
            </details>
          )}
        </section>
      ))}
    {spotifyEmbed && <SpotifyEmbed embed={spotifyEmbed} />}
  </div>
)}
