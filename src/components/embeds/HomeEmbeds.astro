---
import * as stylex from '@stylexjs/stylex';
import { embeds as styles } from '../../styles/embeds';
import Icon from '../Icon.astro';
import SpotifyEmbed from './SpotifyEmbed.astro';
import type { Embed } from '../../portfolio/embeds';
interface Props {
  embeds: readonly Embed[];
}
const { embeds } = Astro.props;
const spotifyEmbed = embeds.find((embed) => embed.id === 'spotify');
const languageIcons = {
  Rust: 'rust',
  TypeScript: 'typescript',
  JavaScript: 'javascript',
} as const;
const languageIcon = (language: string) =>
  languageIcons[language as keyof typeof languageIcons];
const messages = {
  empty: 'Nothing to show yet.',
  unavailable: 'This source is currently unavailable.',
};
const timestamp = (value: string) =>
  new Date(value).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
---

{embeds.length > 0 && (
  <div {...stylex.attrs(styles.grid)}>
    {embeds
      .filter((embed) => embed.id !== 'spotify')
      .map((embed) => (
        <section
          {...stylex.attrs(
            styles.section,
            (embed.id === 'x' || embed.id === 'github') &&
              styles.activitySection,
          )}
          aria-labelledby={`embed-${embed.id}`}
        >
          <header {...stylex.attrs(styles.header)}>
            <div {...stylex.attrs(styles.identity)}>
              {(embed.id === 'x' || embed.id === 'github') && (
                <Icon name={embed.id} />
              )}
              <div {...stylex.attrs(styles.headingGroup)}>
                <h2 id={`embed-${embed.id}`} {...stylex.attrs(styles.title)}>
                  {embed.title}
                </h2>
                <a
                  {...stylex.attrs(styles.link, styles.sourceLink)}
                  href={embed.href}
                  rel="noreferrer"
                >
                  {embed.source}
                </a>
              </div>
            </div>
          </header>
          {(embed.status === 'empty' || embed.status === 'unavailable') && (
            <p {...stylex.attrs(styles.meta)}>{messages[embed.status]}</p>
          )}
          {embed.id !== 'x' && embed.updatedAt && (
            <p {...stylex.attrs(styles.meta)}>
              Updated{' '}
              <time datetime={embed.updatedAt}>
                {timestamp(embed.updatedAt)}
              </time>
            </p>
          )}
          {embed.items.length > 0 && (
            <ul
              {...stylex.attrs(
                styles.list,
                (embed.id === 'x' || embed.id === 'github') &&
                  styles.activityList,
              )}
            >
              {embed.items.map((item) => (
                <li
                  {...stylex.attrs(
                    styles.item,
                    (item.kind === 'post' || item.kind === 'repository') &&
                      styles.activityItem,
                  )}
                >
                  {item.kind !== 'post' && (
                    <a
                      {...stylex.attrs(
                        styles.link,
                        item.kind === 'repository' && styles.repositoryTitle,
                      )}
                      href={item.href}
                      rel="noreferrer"
                    >
                      {item.title}
                    </a>
                  )}
                  {item.detail && (
                    <span
                      {...stylex.attrs(
                        styles.detail,
                        item.kind === 'repository' && styles.repositoryDetail,
                      )}
                    >
                      {item.detail}
                    </span>
                  )}
                  {item.kind === 'post' && (
                    <p {...stylex.attrs(styles.post)}>
                      <a
                        {...stylex.attrs(styles.link, styles.postLink)}
                        href={item.href}
                        rel="noreferrer"
                      >
                        {item.text}
                      </a>
                    </p>
                  )}
                  {item.kind === 'post' &&
                    (item.likes !== undefined ||
                      item.reposts !== undefined) && (
                      <div {...stylex.attrs(styles.postStats)}>
                        {item.likes !== undefined && (
                          <span
                            {...stylex.attrs(styles.postStat)}
                            role="img"
                            aria-label={`${item.likes.toLocaleString('en-US')} likes`}
                          >
                            <Icon name="heart" />
                            {item.likes.toLocaleString('en-US')}
                          </span>
                        )}
                        {item.reposts !== undefined && (
                          <span
                            {...stylex.attrs(styles.postStat)}
                            role="img"
                            aria-label={`${item.reposts.toLocaleString('en-US')} reposts`}
                          >
                            <Icon name="repost" />
                            {item.reposts.toLocaleString('en-US')}
                          </span>
                        )}
                      </div>
                    )}
                  {item.kind === 'track' && item.playedAt && (
                    <time
                      {...stylex.attrs(styles.detail)}
                      datetime={item.playedAt}
                    >
                      {timestamp(item.playedAt)}
                    </time>
                  )}
                  {item.kind === 'repository' &&
                    (item.language || item.commits !== undefined) && (
                      <div
                        {...stylex.attrs(styles.detail, styles.repositoryMeta)}
                      >
                        {item.language && (
                          <span {...stylex.attrs(styles.language)}>
                            {languageIcon(item.language) && (
                              <Icon name={languageIcon(item.language)} />
                            )}
                            {item.language}
                          </span>
                        )}
                        {item.commits !== undefined && (
                          <span
                            title={
                              item.commitWeeks
                                ? `Commits in the last ${item.commitWeeks} weeks`
                                : undefined
                            }
                          >
                            {item.commits}{' '}
                            {item.commits === 1 ? 'commit' : 'commits'}
                          </span>
                        )}
                      </div>
                    )}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    {spotifyEmbed && <SpotifyEmbed embed={spotifyEmbed} />}
  </div>
)}
