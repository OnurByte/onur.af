---
import '../styles/global.css';
const { title = 'Onur Stirner' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <meta name="description" content="Onur Stirner — independent work and Monero donations." />
  </head>
  <body><slot /></body>
</html>
