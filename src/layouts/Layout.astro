---
import '../styles/global.css';
import { portfolioLinks } from '../portfolio/links';
const { title = 'Onur Stirner' } = Astro.props;
const links = portfolioLinks();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <meta name="description" content="Onur Stirner — independent work and Monero donations." />
  </head>
  <body>
    <slot />
    <footer class="site-footer" aria-label="Contact and donation links">
      <span class="footer-name">ONUR STIRNER</span>
      <nav aria-label="Alternate sites and contact">
        {links.map(({ label, href }) => <a href={href}>{label}</a>)}
        <a href="/donate">DONATE</a>
      </nav>
    </footer>
  </body>
</html>
