---
import '../styles/global.css';
import { portfolioLinks } from '../portfolio/links';
import Brand from '../components/Brand.astro';
import NetworkIcon from '../components/NetworkIcon.astro';
import { canonicalUrl, siteDescription, siteOrigin } from '../portfolio/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Onur',
  description = siteDescription,
  noindex = false,
} = Astro.props;
const links = portfolioLinks();
const origin = siteOrigin();
const socialImage = origin ? `${origin}/brand/social.png` : undefined;
const canonical = canonicalUrl(origin, Astro.url.pathname);
const indexable =
  Boolean(canonical) && !noindex && Astro.response.status === 200;
const oembedUrl =
  indexable && canonical
    ? `${origin}/oembed.json?url=${encodeURIComponent(canonical)}&format=json`
    : undefined;
const iconUrl = origin ? `${origin}/brand/icon.png` : '/brand/icon.png';
const discordEmbed =
  indexable && Astro.url.pathname === '/'
    ? {
        component: {
          type: 17,
          accent_color: 0xffffff,
          components: [
            {
              type: 9,
              components: [{ type: 10, content: `# Onur\n${description}` }],
              accessory: {
                type: 11,
                media: { url: iconUrl },
                description: 'Onur — geometric ribbon mark',
              },
            },
            {
              type: 1,
              components: [
                { type: 2, style: 5, label: 'Open site', url: `${origin}/` },
                { type: 2, style: 5, label: 'PGP', url: `${origin}/pgp` },
                { type: 2, style: 5, label: 'RSS', url: `${origin}/rss` },
              ],
            },
          ],
        },
      }
    : undefined;
const schema =
  indexable && Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${origin}/#website`,
            url: `${origin}/`,
            name: 'Onur',
            description,
            publisher: { '@id': `${origin}/#person` },
          },
          {
            '@type': 'Person',
            '@id': `${origin}/#person`,
            name: 'Onur',
            url: `${origin}/`,
          },
        ],
      }
    : undefined;
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    {indexable && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Onur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {indexable && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        {socialImage.startsWith('https://') && (
          <meta property="og:image:secure_url" content={socialImage} />
        )}
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Onur — geometric ribbon mark" />
      </>
    )}
    {oembedUrl && (
      <link
        rel="alternate"
        type="application/json+oembed"
        href={oembedUrl}
        title={title}
      />
    )}
    {discordEmbed && (
      <script
        id="discord:component-embed"
        type="application/json"
        set:html={JSON.stringify(discordEmbed).replaceAll('<', '\\u003c')}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content="Onur — geometric ribbon mark" />
      </>
    )}
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
      />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Onur — working notes"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href={iconUrl} />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href={origin ? `${origin}/favicon.ico` : '/favicon.ico'}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={
        origin
          ? `${origin}/brand/apple-touch-icon.png`
          : '/brand/apple-touch-icon.png'
      }
    />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        {Astro.url.pathname === '/' ? (
          <span class="home-link">
            <Brand />
          </span>
        ) : (
          <a class="home-link" href="/" aria-label="Onur home">
            <Brand />
          </a>
        )}
      </nav>
    </header>
    <div id="content" class="page-content" tabindex="-1">
      <slot />
    </div>
    <footer class="site-footer" aria-label="Contact and donation links">
      <nav class="footer-nav" aria-label="Alternate sites and contact">
        <span class="footer-identity">
          <a class="footer-link footer-pgp" href="/pgp">
            PGP
          </a>
          <a class="footer-link" href="/rss" aria-label="RSS">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="5" cy="19" r="2" fill="white" />
              <path
                d="M3 11a10 10 0 0 1 10 10M3 3a18 18 0 0 1 18 18"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </a>
        </span>
        <span class="footer-networks">
          {links
            .filter(({ label }) => label !== 'PGP')
            .map(({ label, href }) => {
              return href ? (
                <a class="footer-link" href={href} aria-label={label}>
                  <NetworkIcon network={label === 'TOR' ? 'TOR' : 'I2P'} />
                </a>
              ) : (
                <span
                  class="footer-link unavailable-link"
                  role="img"
                  aria-label={label}
                  title={`${label} address not published`}
                >
                  <NetworkIcon network={label === 'TOR' ? 'TOR' : 'I2P'} />
                </span>
              );
            })}
        </span>
        <a class="footer-link footer-donate" href="/donate">
          DONATE
        </a>
      </nav>
    </footer>
  </body>
</html>
