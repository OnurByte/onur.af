---
import '../styles/global.css';
import { portfolioLinks } from '../portfolio/links';
import Brand from '../components/Brand.astro';
const { title = 'Onur' } = Astro.props;
const links = portfolioLinks();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>{title}</title>
    <meta name="description" content="Onur — independent software." />
    <link rel="icon" type="image/svg+xml" href="/brand/onur.svg" />
  </head>
  <body>
    <slot />
    <footer class="site-footer" aria-label="Contact and donation links">
      <span class="footer-name"><Brand /></span>
      <nav aria-label="Alternate sites and contact">
        {links.map(({ label, href }) => href ? <a href={href}>{label}</a> : <span class="unavailable-link" title="Address not published">{label}</span>)}
        <a href="/donate">DONATE</a>
      </nav>
    </footer>
  </body>
</html>
