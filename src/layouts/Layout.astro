---
import '../styles/global.css';
import { portfolioLinks } from '../portfolio/links';
import Brand from '../components/Brand.astro';
const { title = 'Onur' } = Astro.props;
const links = portfolioLinks();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>{title}</title>
    <meta name="description" content="Onur — independent software." />
    <link rel="icon" type="image/svg+xml" href="/brand/onur.svg" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="home-link" href="/" aria-label="Onur home"><Brand /></a>
        <a class="github-link" href="https://github.com/OnurByte" rel="me">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" aria-label="Contact and donation links">
      <nav aria-label="Alternate sites and contact">
        {links.map(({ label, href }) => {
          const icon = label === 'TOR' ? '/brand/tor.svg' : label === 'I2P' ? '/brand/i2p.svg' : undefined;
          return href
            ? <a class="footer-link" href={href}>{icon && <img src={icon} alt="" aria-hidden="true" />}{label}</a>
            : <span class="footer-link unavailable-link" title="Address not published">{icon && <img src={icon} alt="" aria-hidden="true" />}{label}</span>;
        })}
        <a href="/donate">DONATE</a>
      </nav>
    </footer>
  </body>
</html>
