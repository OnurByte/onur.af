---
import { portfolioLinks } from '../portfolio/links';
import { mottos, publicPreview } from '../portfolio/previews';
import Brand from '../components/Brand.astro';
import NetworkIcon from '../components/NetworkIcon.astro';
import { canonicalUrl, siteDescription, siteOrigin } from '../portfolio/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  motto?: string;
}
const {
  title = 'Onur',
  description: suppliedDescription = siteDescription,
  motto = mottos[0],
  noindex = false,
} = Astro.props;
const links = portfolioLinks();
const origin = siteOrigin();
const preview = publicPreview(Astro.url.pathname);
const description = preview?.description ?? suppliedDescription;
const canonical = canonicalUrl(origin, Astro.url.pathname);
const indexable =
  Boolean(canonical) && !noindex && Astro.response.status === 200;
const socialImage =
  indexable && preview
    ? `${origin}/social/${preview.key}.png?m=${mottos.indexOf(motto as (typeof mottos)[number])}`
    : undefined;
const imageAlt = `${preview?.title ?? title} — ${description}`;
const oembedUrl =
  indexable && canonical
    ? `${origin}/oembed.json?url=${encodeURIComponent(canonical)}&format=json`
    : undefined;
const iconUrl = origin ? `${origin}/brand/icon.png` : '/brand/icon.png';
const discordEmbed =
  indexable && preview
    ? {
        component: {
          type: 17,
          accent_color: 0xffffff,
          components: [
            {
              type: 12,
              items: [{ media: { url: socialImage }, description: imageAlt }],
            },
            {
              type: 1,
              components: [
                { type: 2, style: 5, label: 'Open page', url: canonical },
                { type: 2, style: 5, label: 'PGP', url: `${origin}/pgp` },
                { type: 2, style: 5, label: 'RSS', url: `${origin}/rss` },
              ],
            },
          ],
        },
      }
    : undefined;
const schema =
  indexable && Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${origin}/#website`,
            url: `${origin}/`,
            name: 'Onur',
            description,
            publisher: { '@id': `${origin}/#person` },
          },
          {
            '@type': 'Person',
            '@id': `${origin}/#person`,
            name: 'Onur',
            url: `${origin}/`,
          },
        ],
      }
    : undefined;
---

<!doctype html>
<html
  lang="en"
  prefix="og: https://ogp.me/ns#"
  class="[color-scheme:light] [--background:#fff] [--text:#0d0d0d] [--muted:#333] [--border:#b3b3b3] [--surface:#f2f2f2] dark:[color-scheme:dark] dark:[--background:#000] dark:[--text:#fff] dark:[--muted:#fff] dark:[--border:#404040] dark:[--surface:#222]"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    {indexable && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Onur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {indexable && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        {socialImage.startsWith('https://') && (
          <meta property="og:image:secure_url" content={socialImage} />
        )}
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}
    {oembedUrl && (
      <link
        rel="alternate"
        type="application/json+oembed"
        href={oembedUrl}
        title={title}
      />
    )}
    {discordEmbed && (
      <script
        id="discord:component-embed"
        type="application/json"
        set:html={JSON.stringify(discordEmbed).replaceAll('<', '\\u003c')}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
      />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Onur — working notes"
      href="/rss.xml"
    />
    <link rel="icon" type="image/png" sizes="512x512" href={iconUrl} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={origin ? `${origin}/brand/favicon.svg` : '/brand/favicon.svg'}
    />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href={origin ? `${origin}/favicon.ico` : '/favicon.ico'}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={
        origin
          ? `${origin}/brand/apple-touch-icon.png`
          : '/brand/apple-touch-icon.png'
      }
    />
  </head>
  <body class="m-0 flex min-h-svh min-w-80 flex-col bg-[var(--background)] font-sans text-base leading-[1.6] text-[var(--text)] [font-synthesis:none] [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-3 [&_button:focus-visible]:outline-2 [&_button:focus-visible]:outline-offset-3 motion-reduce:[&_*]:animate-none motion-reduce:[&_*]:scroll-auto motion-reduce:[&_*]:transition-none">
    <a
      class="absolute -top-25 left-6 z-10 bg-[var(--background)] p-3 focus:top-3 max-[620px]:left-5"
      href="#content"
    >
      Skip to content
    </a>
    <header class="mx-auto flex w-[calc(100%-48px)] max-w-240 items-center justify-between gap-5 py-6 max-[620px]:w-[calc(100%-40px)]">
      <nav
        class="flex w-full items-center justify-between gap-5"
        aria-label="Main navigation"
      >
        {Astro.url.pathname === '/' ? (
          <span class="text-[2.5rem] font-medium leading-[1.15]">
            <Brand />
          </span>
        ) : (
          <a
            class="text-[2.5rem] font-medium leading-[1.15] no-underline"
            href="/"
            aria-label="Onur home"
          >
            <Brand />
          </a>
        )}
      </nav>
    </header>
    <div id="content" class="flex-1" tabindex="-1">
      <slot />
    </div>
    <footer
      class="mx-auto flex w-[calc(100%-48px)] max-w-240 items-center justify-between gap-5 pt-5 pb-7 text-xl font-bold max-[620px]:w-[calc(100%-40px)] max-[620px]:text-base"
      aria-label="Contact and donation links"
    >
      <nav
        class="grid w-full grid-cols-[1fr_auto_1fr] items-center gap-5 max-[620px]:gap-1"
        aria-label="Alternate sites and contact"
      >
        <span class="flex items-center justify-self-start gap-5 max-[620px]:gap-3">
          <a
            class="inline-flex min-h-8 items-center gap-2 no-underline"
            href="/pgp"
          >
            PGP
          </a>
          <a
            class="inline-flex min-h-8 items-center gap-2 no-underline"
            href="/rss"
            aria-label="RSS"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="brightness-0 dark:invert"
            >
              <circle cx="5" cy="19" r="2" fill="white" />
              <path
                d="M3 11a10 10 0 0 1 10 10M3 3a18 18 0 0 1 18 18"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </a>
        </span>
        <span class="flex items-center justify-self-center gap-5 max-[620px]:gap-3">
          {links
            .filter(({ label }) => label !== 'PGP')
            .map(({ label, href }) => {
              return href ? (
                <a
                  class="inline-flex min-h-8 items-center gap-2 no-underline"
                  href={href}
                  aria-label={label}
                >
                  <NetworkIcon network={label === 'TOR' ? 'TOR' : 'I2P'} />
                </a>
              ) : (
                <span
                  class="inline-flex min-h-8 cursor-default items-center gap-2 text-[var(--muted)]"
                  role="img"
                  aria-label={label}
                  title={`${label} address not published`}
                >
                  <NetworkIcon network={label === 'TOR' ? 'TOR' : 'I2P'} />
                </span>
              );
            })}
        </span>
        <a
          class="inline-flex min-h-8 items-center justify-self-end gap-2 no-underline"
          href="/donate"
        >
          DONATE
        </a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  @import 'tailwindcss';
  @theme {
    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
</style>
