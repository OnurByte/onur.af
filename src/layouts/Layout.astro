---
import * as stylex from '@stylexjs/stylex';
import { siteSignature } from '../portfolio/signature';
import { scrollProfileForPath } from '../portfolio/scroll';
import { shell } from '../styles/shell';
import { edge } from '../styles/edge';
import '../styles/global.css';
import { identityAccounts } from '../portfolio/identity-accounts';
import { portfolioLinks } from '../portfolio/links';
import { mottos, publicPreview, socialPreviewUrl } from '../portfolio/previews';
import Brand from '../components/Brand.astro';
import Search from '../components/Search.astro';
import ScrollRail from '../components/ScrollRail.astro';
import TextSelection from '../components/TextSelection.astro';
import Cursor from '../components/Cursor.astro';
import { glassSurface } from '../styles/glass-surface';
import Icon from '../components/Icon.astro';
import {
  canonicalUrl,
  siteDescription,
  siteOrigin,
  robotsContent,
  robotsMetaContent,
  isIndexableRobots,
  homePageSchema,
} from '../portfolio/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  language?: string;
  previewRevision?: number;
  quote?: { logId: string; selector: string };
  article?: { publishedAt: string; modifiedAt: string; tags: string[] };
  structuredData?: object | undefined;
}
const {
  title = 'Onur',
  description: suppliedDescription,
  noindex = false,
  language = 'en',
  article,
  structuredData,
  previewRevision,
  quote,
} = Astro.props;
const links = portfolioLinks();
const origin = siteOrigin(Astro.site);
const preview = publicPreview(
  quote ? `/log/${quote.logId}` : Astro.url.pathname,
  previewRevision,
);
const description =
  suppliedDescription ?? preview?.description ?? siteDescription;
const canonical =
  quote && origin
    ? new URL(Astro.url.pathname, origin).href
    : canonicalUrl(origin, Astro.url.pathname);
const robots = robotsMetaContent(
  robotsContent(Astro.url.pathname, {
    noindex: noindex || process.env['VERCEL_ENV'] === 'preview',
    status: Astro.response.status ?? 200,
  }),
);
const indexable = isIndexableRobots(robots) && Boolean(canonical);
const shareMetadata =
  indexable ||
  Boolean(
    quote &&
    process.env['VERCEL_ENV'] !== 'preview' &&
    origin &&
    preview &&
    isIndexableRobots(robotsContent(`/log/${quote.logId}`)),
  );
const socialImage =
  shareMetadata && origin && preview
    ? quote
      ? new URL(`/log/${quote.logId}/quote/${quote.selector}.png`, origin).href
      : socialPreviewUrl(origin, preview)
    : undefined;
const shareUrl =
  canonical && previewRevision && !quote
    ? `${canonical}?v=${String(previewRevision)}`
    : canonical;
const imageAlt =
  preview?.key === 'home'
    ? mottos[0]
    : [preview?.title ?? title, description].filter(Boolean).join(' ⁜ ');
const oembedUrl =
  indexable && !quote && preview && shareUrl
    ? `${origin}/oembed.json?url=${encodeURIComponent(shareUrl)}&format=json`
    : undefined;
const iconUrl = origin ? `${origin}/brand/icon.png` : '/brand/icon.png';
const discordEmbed =
  shareMetadata && preview
    ? {
        component: {
          type: 17,
          accent_color: 0xffffff,
          components: [
            {
              type: 12,
              items: [{ media: { url: socialImage }, description: imageAlt }],
            },
            {
              type: 1,
              components: [
                { type: 2, style: 5, label: 'Open page', url: shareUrl },
                { type: 2, style: 5, label: 'PGP', url: `${origin}/pgp` },
                { type: 2, style: 5, label: 'RSS', url: `${origin}/rss` },
                {
                  type: 2,
                  style: 5,
                  label: 'Discord',
                  url: 'https://discord.com/users/1434953668959932426',
                },
              ],
            },
          ],
        },
      }
    : undefined;
const schema = Astro.url.pathname === '/' ? homePageSchema(origin) : undefined;
---

<!doctype html>
<Fragment set:html={`<!--\n${siteSignature}\n-->`} />
<html
  lang={language}
  prefix="og: https://ogp.me/ns#"
  data-scroll-profile={scrollProfileForPath(Astro.url.pathname)}
>
  <head>
    <link rel="preload" as="image" href="/brand/onur.svg" />
    {process.env['PORTFOLIO_VITALS_ENABLED'] === '1' && (
      <meta name="portfolio-vitals" content="enabled" />
    )}
    {import.meta.env.DEV && (
      <link rel="stylesheet" href="/virtual:stylex.css" />
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Object.values(identityAccounts).map((account) => (
      <link rel="me" href={account.profile} />
    ))}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedAt} />
        <meta property="article:modified_time" content={article.modifiedAt} />
        {origin && <meta property="article:author" content={`${origin}/`} />}
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta property="og:site_name" content="Onur" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta
      property="og:locale"
      content={
        language === 'tr'
          ? 'tr_TR'
          : language === 'en'
            ? 'en_US'
            : language.replace('-', '_')
      }
    />
    {shareMetadata && <meta property="og:url" content={shareUrl} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        {socialImage.startsWith('https://') && (
          <meta property="og:image:secure_url" content={socialImage} />
        )}
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}
    {oembedUrl && (
      <link
        rel="alternate"
        type="application/json+oembed"
        href={oembedUrl}
        title={title}
      />
    )}
    {discordEmbed && (
      <script
        id="discord:component-embed"
        type="application/json"
        set:html={JSON.stringify(discordEmbed).replaceAll('<', '\\u003c')}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    {indexable && (structuredData ?? schema) && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData ?? schema).replaceAll(
          '<',
          '\\u003c',
        )}
      />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Onur ⁜ RSS"
      href="/rss.xml"
    />
    <link rel="icon" type="image/png" sizes="512x512" href={iconUrl} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={origin ? `${origin}/brand/favicon.svg` : '/brand/favicon.svg'}
    />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href={origin ? `${origin}/favicon.ico` : '/favicon.ico'}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={
        origin
          ? `${origin}/brand/apple-touch-icon.png`
          : '/brand/apple-touch-icon.png'
      }
    />
  </head>
  <body {...stylex.attrs(shell.body)}>
    <header {...stylex.attrs(shell.header)}>
      <nav
        {...stylex.attrs(
          shell.container,
          shell.navigation,
          glassSurface.material,
        )}
        aria-label="Main navigation"
        data-nav-glass
      >
        <a
          {...stylex.attrs(shell.title, shell.link)}
          href="/"
          aria-label="Onur home"
        >
          <Brand />
        </a>
        <div {...stylex.attrs(shell.navigationActions)}>
          <a
            {...stylex.attrs(shell.navigationLink)}
            href="/log"
            aria-current={Astro.url.pathname === '/log' ? 'page' : undefined}
          >
            <i
              aria-hidden="true"
              {...stylex.attrs(shell.navigationLinkBorder, edge.ring)}
            ></i>
            Log
          </a>
          <Search />
        </div>
        <span
          {...stylex.attrs(shell.navigationBorder, edge.ring)}
          aria-hidden="true"
        />
      </nav>
    </header>
    <div id="content" {...stylex.attrs(shell.content)} tabindex="-1">
      <slot />
    </div>
    <ScrollRail />
    <Cursor />
    <footer
      {...stylex.attrs(shell.container, shell.footer)}
      aria-label="Contact and contribution links"
    >
      <nav
        {...stylex.attrs(shell.footerNavigation)}
        aria-label="Alternate sites and contact"
      >
        <span {...stylex.attrs(shell.footerGroup, shell.start)}>
          <a {...stylex.attrs(shell.footerLink, shell.link)} href="/pgp">
            PGP
          </a>
          <a
            {...stylex.attrs(shell.footerLink, shell.link)}
            href="/rss"
            aria-label="RSS"
          >
            <Icon name="rss" />
          </a>
        </span>
        <span {...stylex.attrs(shell.footerGroup, shell.center)}>
          {links.map(({ label, href }) => {
            return href ? (
              <a
                {...stylex.attrs(shell.footerLink, shell.link)}
                href={href}
                aria-label={label}
              >
                <Icon name={label === 'TOR' ? 'tor' : 'i2p'} />
              </a>
            ) : (
              <span
                {...stylex.attrs(shell.footerLink, shell.unavailable)}
                role="img"
                aria-label={label}
                title={`${label} address not published`}
              >
                <Icon name={label === 'TOR' ? 'tor' : 'i2p'} />
              </span>
            );
          })}
        </span>
        <a
          {...stylex.attrs(shell.footerLink, shell.link, shell.end)}
          href="/contribute"
        >
          CONTRIBUTE
        </a>
      </nav>
    </footer>
    <TextSelection />
  </body>
</html>

<script>
  import '../client/site';
</script>

<script>
  import '../client/vitals';
</script>
