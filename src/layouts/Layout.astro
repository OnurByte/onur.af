---
import '../styles/global.css';
import { portfolioLinks } from '../portfolio/links';
import Brand from '../components/Brand.astro';
const { title = 'Onur' } = Astro.props;
const links = portfolioLinks();
---
<!doctype html>
<html lang="en" data-theme="bleed">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151826" />
    <title>{title}</title>
    <meta name="description" content="Onur — independent software." />
    <link rel="icon" type="image/svg+xml" href="/brand/onur.svg" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="home-link" href="/" aria-label="Onur home"><Brand /></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" aria-label="Contact and donation links">
      <nav class="footer-nav" aria-label="Alternate sites and contact">
        {links.filter(({ label }) => label === 'PGP').map(({ href }) => href
          ? <a class="footer-link footer-pgp" href={href}>PGP</a>
          : <span class="footer-link footer-pgp unavailable-link" title="Address not published">PGP</span>)}
        <span class="footer-networks">
          {links.filter(({ label }) => label !== 'PGP').map(({ label, href }) => {
            const icon = label === 'TOR' ? '/brand/tor.svg' : '/brand/i2p.svg';
            return href
              ? <a class="footer-link" href={href} aria-label={label}><img src={icon} alt="" aria-hidden="true" /></a>
              : <span class="footer-link unavailable-link" role="img" aria-label={label} title={`${label} address not published`}><img src={icon} alt="" aria-hidden="true" /></span>;
          })}
        </span>
        <a class="footer-link footer-donate" href="/donate">DONATE</a>
      </nav>
    </footer>
  </body>
</html>
