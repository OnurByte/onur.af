# Server-only credentials. Never commit .env.
# Public production origin for canonical URLs, social metadata and the sitemap.
SITE_URL=
PORTFOLIO_TOR_URL=
PORTFOLIO_I2P_URL=
DONATION_DATABASE_URL=postgres://localhost:5432/portfolio
DONATION_GATEWAY_URL=http://127.0.0.1:8790
DONATION_GATEWAY_PORT=8790
DONATION_GATEWAY_TOKEN=
XMR_AGENT_URL=http://127.0.0.1:8788
XMR_AGENT_TOKEN=
XMR_NETWORK=stagenet
# Bundled xmr-pay host: generate/configure these locally; never paste private keys in chat.
# Single primary wallet identity for the agent. OpenAlias is public and optional.
XMR_OPENALIAS=
XMR_PRIMARY_ADDRESS=
XMR_VIEW_KEY=
XMR_WALLET_PATH=
XMR_WALLET_PASSWORD=
XMR_RESTORE_HEIGHT=
XMR_AGENT_PORT=8788
# Required node configuration follows xmr-pay/nodes; use an explicitly configured local node.
XMR_NODES=

# Optional first-party vital observations; disabled unless set to 1.
PORTFOLIO_VITALS_ENABLED=0

# Private server diagnostics (not analytics). Local default: .local/debug.log.
# Vercel uses ephemeral /tmp/onur-debug.log and mirrors entries to Runtime Logs.
PORTFOLIO_DEBUG_ENABLED=1
# Optional server-only path override; keep outside public/.
PORTFOLIO_DEBUG_FILE=
