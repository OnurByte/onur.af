{
  "ci": {
    "collect": {
      "startServerCommand": "node dist/server/entry.mjs",
      "startServerReadyPattern": "Server listening",
      "url": [
        "http://portfolio.example:14324/",
        "http://portfolio.example:14324/rss",
        "http://portfolio.example:14324/pgp",
        "http://portfolio.example:14324/donate",
        "http://portfolio.example:14324/search"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --no-proxy-server --host-resolver-rules=\"MAP portfolio.example 127.0.0.1\"",
        "skipAudits": ["is-on-https", "redirects-http"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}
