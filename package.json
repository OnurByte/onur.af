{
  "name": "onur-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "bun test",
    "build": "bun run key-history:verify && bun run proofs:verify && bun run rss:verify && bun run timestamps:verify && bun run log-publications:verify && bun run checkpoints --check && bun run sources --check && bun run derived:verify && bun run log-proofs:verify && bun run proof-verifier:build && bun run evidence:build && astro build",
    "gateway": "bun src/gateway.ts",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check && tsc --noEmit",
    "test:wallet": "bun scripts/probe-wallet.ts",
    "agent": "bun src/xmr/agent-host.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode:check": "knip --include nsExports,nsTypes",
    "test:browser": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "verify": "bun run deadcode:check && bun run format:check && bun run lint && bun run type-coverage:check && bun run architecture:check && bun run check && bun run build && bun test",
    "rss:sign": "bun scripts/rss-sign.ts",
    "rss:verify": "bun scripts/rss-sign.ts --check",
    "proofs:sign": "bun scripts/proofs.ts",
    "proofs:verify": "bun scripts/proofs.ts --check",
    "key-history:verify": "bun scripts/key-history.ts --check",
    "timestamps:stamp": "bun scripts/log-timestamps.ts stamp",
    "timestamps:upgrade": "bun scripts/log-timestamps.ts upgrade",
    "timestamps:verify": "bun scripts/log-timestamps.ts --check",
    "log-publications:verify": "bun scripts/log-publications.ts --check",
    "log:publish": "bun scripts/publish-log.ts",
    "log:new": "bun scripts/log-new.ts",
    "log:distribute": "bun scripts/distribute-log.ts",
    "checkpoints": "bun scripts/publication-checkpoints.ts",
    "sources": "bun scripts/log-sources.ts",
    "derived:verify": "bun scripts/log-derived.ts",
    "log-proofs:verify": "bun scripts/log-proofs.ts --check",
    "log:archive": "bun scripts/log-bundle.ts",
    "keys": "bun scripts/key-history.ts",
    "proof-verifier:build": "bun build scripts/verify-log-bundle.ts --target=node --outfile=public/proof-verifier.mjs --banner 'import { createRequire as __proofCreateRequire } from \"node:module\"; const require = __proofCreateRequire(import.meta.url);'",
    "lint": "astro sync && eslint src tests scripts integrations astro.config.ts playwright.config.ts playwright.smoke.config.ts --max-warnings 0",
    "type-coverage:check": "astro sync && type-coverage --strict --at-least 98.08",
    "architecture:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "evidence:build": "bun scripts/build-evidence.ts generate",
    "evidence:verify": "bun scripts/build-evidence.ts record verify",
    "dependencies:inventory": "bun scripts/dependency-inventory.ts",
    "measure:home": "bun scripts/measure-home.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/vercel": "^11.0.14",
    "@stylexjs/stylex": "^0.19.1",
    "@vercel/blob": "^2.8.2",
    "astro": "^7.3.8",
    "diff": "^9.0.0",
    "hast-util-to-text": "^4.0.2",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.19.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "minisearch": "^7.2.0",
    "monero-ts": "0.11.20",
    "openpgp": "6.3.2",
    "opentimestamps": "^0.4.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "web-vitals": "6.2.3",
    "xmr-pay": "github:SlowBearDigger/xmr-pay#26d25eea800b831c6a90d180c698a4ac6426502c"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/bun": "latest",
    "@types/hast": "^3.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-check": "^4.10.2",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "type-coverage": "^2.30.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=26.4.0",
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "request@2.88.2": "patches/request@2.88.2.patch",
    "opentimestamps@0.4.9": "patches/opentimestamps@0.4.9.patch"
  }
}
