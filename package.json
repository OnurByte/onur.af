{
  "name": "onur-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "bun test",
    "build": "bun run search:index && astro build",
    "gateway": "bun src/gateway.ts",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check && tsc --noEmit",
    "test:wallet": "bun scripts/probe-wallet.ts",
    "agent": "bun src/xmr/agent-host.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "search:index": "bun scripts/build-search.ts",
    "test:browser": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "verify": "bun run format:check && bun run check && bun run build && bun test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/vercel": "^11.0.14",
    "@stylexjs/stylex": "^0.19.1",
    "astro": "^7.3.8",
    "monero-ts": "0.11.20",
    "sharp": "0.35.5",
    "xmr-pay": "github:SlowBearDigger/xmr-pay#26d25eea800b831c6a90d180c698a4ac6426502c"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/bun": "latest",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
